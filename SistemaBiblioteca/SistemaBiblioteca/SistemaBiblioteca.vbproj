<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SistemaBiblioteca</RootNamespace>
    <UseWPF>true</UseWPF>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>

    <!-- Icono del ARCHIVO .exe. `Icon="{StaticResource IconoApp}"` en las ventanas
         solo pinta el icono en tiempo de ejecución; sin esto, el Explorador y los
         accesos directos muestran el icono genérico de Windows. -->
    <ApplicationIcon>Assets\alejandria.ico</ApplicationIcon>

    <AssemblyTitle>Biblioteca Alejandría</AssemblyTitle>
    <Product>Biblioteca Alejandría</Product>
    <Description>Sistema de gestión bibliotecaria — III Parcial</Description>
    <Company>Alejandro Calderón</Company>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

</Project>
