<Application x:Class="Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             StartupUri="Views/SplashWindow.xaml">
    <Application.Resources>

        <!-- ══════════════════════════════════════════════════════════════════
             SISTEMA DE DISEÑO — ALEJANDRÍA
             Todo el aspecto visual del sistema vive aquí: paleta, tipografía,
             botones, campos, tarjetas y tablas. Ninguna vista define colores
             propios; así cambiar la marca es cambiar este archivo.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- ======================= PALETA ======================= -->
        <!-- Verde tinta + dorado sobre papel: la paleta de un libro encuadernado -->
        <Color x:Key="ColorLateral">#14281E</Color>
        <Color x:Key="ColorPrimario">#1B7A52</Color>
        <Color x:Key="ColorAcento">#C9A227</Color>

        <SolidColorBrush x:Key="BrushFondo"         Color="#F5F2EA"/>
        <SolidColorBrush x:Key="BrushLateral"       Color="#14281E"/>
        <SolidColorBrush x:Key="BrushLateralHover"  Color="#21422F"/>
        <SolidColorBrush x:Key="BrushLateralSuave"  Color="#9DBBAA"/>
        <SolidColorBrush x:Key="BrushPrimario"      Color="#1B7A52"/>
        <SolidColorBrush x:Key="BrushPrimarioSuave" Color="#E2F1E9"/>
        <SolidColorBrush x:Key="BrushAcento"        Color="#C9A227"/>
        <SolidColorBrush x:Key="BrushAcentoSuave"   Color="#FBF3D8"/>
        <SolidColorBrush x:Key="BrushExito"         Color="#15803D"/>
        <SolidColorBrush x:Key="BrushExitoSuave"    Color="#DCFCE7"/>
        <SolidColorBrush x:Key="BrushPeligro"       Color="#B91C1C"/>
        <SolidColorBrush x:Key="BrushPeligroSuave"  Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BrushAdvertencia"   Color="#B45309"/>
        <SolidColorBrush x:Key="BrushAdvSuave"      Color="#FEF3C7"/>
        <SolidColorBrush x:Key="BrushGris"          Color="#5A6B62"/>
        <SolidColorBrush x:Key="BrushTexto"         Color="#14231C"/>
        <SolidColorBrush x:Key="BrushTextoSuave"    Color="#6E7D74"/>
        <SolidColorBrush x:Key="BrushBorde"         Color="#E3DED0"/>
        <SolidColorBrush x:Key="BrushSeleccion"     Color="#DCEDE4"/>
        <SolidColorBrush x:Key="BrushBlanco"        Color="#FFFFFF"/>

        <!-- Cuero de encuadernación: se usa en el panel de marca del login y del splash -->
        <LinearGradientBrush x:Key="BrushCuero" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#14281E" Offset="0"/>
            <GradientStop Color="#1D4531" Offset="0.55"/>
            <GradientStop Color="#2C6448" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BrushDorado" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0C44F" Offset="0"/>
            <GradientStop Color="#B08512" Offset="1"/>
        </LinearGradientBrush>

        <!-- ======================= LOGOTIPO ======================= -->
        <!-- El libro abierto de ALEJANDRÍA es vectorial: no depende de ningún
             archivo de imagen y se ve nítido en cualquier tamaño o resolución. -->
        <Geometry x:Key="GeoLibro">M 12,6.2 C 9.6,4.4 6.6,3.7 3,3.9 L 3,18.3 C 6.6,18.1 9.6,18.8 12,20.6 C 14.4,18.8 17.4,18.1 21,18.3 L 21,3.9 C 17.4,3.7 14.4,4.4 12,6.2 Z</Geometry>
        <Geometry x:Key="GeoLomo">M 12,6.2 L 12,20.6</Geometry>

        <DrawingImage x:Key="IconoApp">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#14281E">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24" RadiusX="5" RadiusY="5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C9A227" Geometry="{StaticResource GeoLibro}"/>
                    <GeometryDrawing Geometry="{StaticResource GeoLomo}">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#14281E" Thickness="1.4"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ======================= PARED DE ESTANTERÍA ======================= -->
        <!-- Un tramo de repisa que se repite para llenar el fondo del inicio de
             sesión. Es un DrawingBrush teselado: una sola definición de 200×150
             cubre la ventana entera sin dibujar cientos de rectángulos a mano.
             El mosaico es grande y los lomos anchos a propósito: con lomos finos
             y repetición corta el fondo se lee como un código de barras y no
             como una estantería. -->
        <DrawingBrush x:Key="PatronEstanteria" TileMode="Tile"
                      Viewport="0,0,200,150" ViewportUnits="Absolute"
                      Viewbox="0,0,200,150" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <!-- La tabla de la repisa -->
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,142,200,5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Los lomos, de altos y anchos distintos para que no se
                         note dónde termina un tramo y empieza el siguiente -->
                    <GeometryDrawing Brush="#E8FFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="6,46,22,96"   RadiusX="2" RadiusY="2"/>
                                <RectangleGeometry Rect="52,32,26,110" RadiusX="2" RadiusY="2"/>
                                <RectangleGeometry Rect="151,38,28,104" RadiusX="2" RadiusY="2"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#9EFFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="32,64,16,78"  RadiusX="2" RadiusY="2"/>
                                <RectangleGeometry Rect="104,42,24,100" RadiusX="2" RadiusY="2"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#5CFFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="82,54,18,88"  RadiusX="2" RadiusY="2"/>
                                <RectangleGeometry Rect="132,70,15,72" RadiusX="2" RadiusY="2"/>
                                <RectangleGeometry Rect="183,58,13,84" RadiusX="2" RadiusY="2"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ======================= CONVERSORES ======================= -->
        <local:EstadoAColorConverter        x:Key="EstadoAColor"/>
        <local:EstadoAColorFondoConverter   x:Key="EstadoAColorFondo"/>
        <local:VacioAVisibleConverter       x:Key="VacioAVisible"/>
        <local:PorcentajeAAnchoConverter    x:Key="PorcentajeAAncho"/>
        <local:BooleanoAVisibleConverter    x:Key="BooleanoAVisible"/>
        <local:DiasRestantesATextoConverter x:Key="DiasRestantesATexto"/>
        <local:ConteoAVisibleConverter      x:Key="ConteoAVisible"/>

        <!-- ======================= BOTONES ======================= -->
        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Microinteracción: al pasar el mouse el botón se
                                     ACLARA, no crece. Antes se escalaba un 3 %, y en un
                                     botón ancho eso lo sacaba de su contenedor: el
                                     ScrollViewer que lo envuelve le recortaba las
                                     esquinas redondeadas. Cambiar el brillo no toca el
                                     tamaño, así que nunca desborda. -->
                                <Border x:Name="luz" CornerRadius="9" Background="White" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="luz"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.17" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="luz"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource BrushPrimario}"/>
        </Style>
        <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource BrushExito}"/>
        </Style>
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource BrushPeligro}"/>
        </Style>
        <Style x:Key="BotonGris" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource BrushGris}"/>
        </Style>
        <Style x:Key="BotonAcento" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource BrushAcento}"/>
            <Setter Property="Foreground" Value="#3A2C05"/>
        </Style>

        <!-- Botón secundario: contorno en vez de relleno, para acciones de menor peso -->
        <Style x:Key="BotonContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BrushPrimario}" BorderThickness="1.5"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimarioSuave}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de solo texto, sin fondo -->
        <Style x:Key="BotonPlano" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAE6DA"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón pequeño para acciones dentro de una fila de tabla -->
        <Style x:Key="BotonFila" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource BrushPrimario}"/>
        </Style>

        <!-- ======================= RIEL DE NAVEGACIÓN ======================= -->
        <!-- El menú lateral es un riel angosto de iconos que se despliega a ancho
             completo con el botón ☰. Cada opción pone su icono en `Tag` y su
             nombre en `Content`: cuando el riel está plegado solo se ve el icono
             y el nombre pasa a ser el ToolTip.
             La etiqueta se ata a la propiedad `MenuExpandido` de la ventana, que
             es quien sabe si el riel está abierto o cerrado. -->
        <Style x:Key="BotonRiel" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B6CEBF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="11" Height="44">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Marca de la opción activa -->
                                <Border x:Name="marca" Grid.Column="0" Width="3" CornerRadius="2"
                                        Margin="0,10" Background="Transparent"/>

                                <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" FontSize="17"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Visibility="{Binding MenuExpandido,
                                                        RelativeSource={RelativeSource AncestorType=Window},
                                                        Converter={StaticResource BooleanoAVisible}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushLateralHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushLateralHover}"/>
                                <Setter TargetName="marca" Property="Background" Value="{StaticResource BrushAcento}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rótulo de grupo dentro del riel; desaparece cuando está plegado -->
        <Style x:Key="RotuloRiel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5F8570"/>
            <Setter Property="Margin" Value="24,16,0,6"/>
            <Setter Property="Visibility"
                    Value="{Binding MenuExpandido, RelativeSource={RelativeSource AncestorType=Window},
                            Converter={StaticResource BooleanoAVisible}}"/>
        </Style>

        <!-- Botón cuadrado solo-icono: el ☰ del riel y la ✕ de las ventanas sin marco -->
        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Variante del anterior para fondos claros -->
        <Style x:Key="BotonIconoClaro" TargetType="Button" BasedOn="{StaticResource BotonIcono}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAE6DA"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip de la cuenta conectada, en el extremo derecho de la barra global -->
        <Style x:Key="ChipUsuario" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="21" Padding="5,4,14,4"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F1E7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Opción dentro del menú desplegable de la cuenta -->
        <Style x:Key="OpcionCuenta" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimarioSuave}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buscador global de la barra superior: forma de píldora -->
        <Style x:Key="CajaBusquedaGlobal" TargetType="TextBox">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="38,0,12,0"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Background" Value="#F3F1E7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.4"
                                CornerRadius="19">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Paso del asistente de préstamo: 1 Socio · 2 Libros · 3 Confirmar -->
        <Style x:Key="PasoAsistente" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="#EAE6DA"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PasoAsistenteActivo" TargetType="Border" BasedOn="{StaticResource PasoAsistente}">
            <Setter Property="Background" Value="{StaticResource BrushPrimario}"/>
        </Style>

        <!-- ======================= CAMPOS ======================= -->
        <Style x:Key="CajaTexto" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.4"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C7C0AC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimario}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F1EFE7"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Variante multilínea (sinopsis, observaciones) -->
        <Style x:Key="CajaTextoLarga" TargetType="TextBox" BasedOn="{StaticResource CajaTexto}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="CajaClave" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.4"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox con el mismo lenguaje visual que las cajas de texto -->
        <Style x:Key="FlechaCombo" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource BrushBorde}"
                                BorderThickness="1.4" CornerRadius="9">
                            <Path x:Name="flecha" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,13,0" Fill="{StaticResource BrushTextoSuave}"
                                  Data="M 0,0 L 9,0 L 4.5,5.5 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C7C0AC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimario}"/>
                                <Setter TargetName="flecha" Property="Fill" Value="{StaticResource BrushPrimario}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F1EFE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="6" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimarioSuave}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSeleccion}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Boton" Style="{StaticResource FlechaCombo}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>

                            <ContentPresenter x:Name="Seleccion" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,32,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <!-- Solo se usa cuando IsEditable = True -->
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden"
                                     Margin="11,0,32,0" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource BrushTexto}"
                                     CaretBrush="{StaticResource BrushPrimario}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <TextBlock x:Name="Marcador" Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                       Margin="13,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{StaticResource BrushTextoSuave}" FontSize="13.5"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="White" CornerRadius="10" Margin="0,4,0,10"
                                        BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#14231C" Opacity="0.18" BlurRadius="16" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,5">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Seleccion" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- Sin selección se muestra el texto guía que la vista pone en Tag -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="SelectedIndex" Value="-1"/>
                                    <Condition Property="IsEditable" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Marcador" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ======================= BARRAS ======================= -->
        <Style x:Key="BarraCarga" TargetType="ProgressBar">
            <Setter Property="Background" Value="#26523A"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAcento}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra fina de disponibilidad del acervo, dentro de las tablas -->
        <Style x:Key="BarraAcervo" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#E6E2D5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= TIPOGRAFÍA ======================= -->
        <Style x:Key="TituloPagina" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>
        <Style x:Key="TituloTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style x:Key="Cifra" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>
        <!-- Códigos de barras, ISBN y signaturas: monoespaciada, como en la ficha -->
        <Style x:Key="Codigo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>
        <!-- El título de un libro se ve mejor con serifa: es un libro, después de todo -->
        <Style x:Key="TituloLibro" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia, Cambria, Times New Roman"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>

        <!-- ======================= ENLACES ======================= -->
        <Style x:Key="EnlaceSutil" TargetType="Hyperlink">
            <Setter Property="TextDecorations" Value="None"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EnlaceEnfasis" TargetType="Hyperlink">
            <Setter Property="TextDecorations" Value="None"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======================= TARJETAS ======================= -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#14231C" Opacity="0.07" BlurRadius="16" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta que responde al mouse: se usa en los resultados del catálogo -->
        <Style x:Key="TarjetaClicable" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tarjeta que flota sobre un fondo a pantalla completa: la del inicio de
             sesión. Lleva más sombra que la normal porque tiene que despegarse de
             una pared oscura, no de un fondo claro. -->
        <Style x:Key="TarjetaFlotante" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="40" ShadowDepth="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Insignia de estado (Disponible, Vencido, Pagada…) -->
        <Style x:Key="Insignia" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TextoInsignia" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Separador punteado del comprobante de préstamo -->
        <Style x:Key="LineaPunteada" TargetType="Line">
            <Setter Property="Stroke" Value="{StaticResource BrushBorde}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeDashArray" Value="3 3"/>
        </Style>

        <!-- ======================= TABLAS ======================= -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0EDE3"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFAF5"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F5EC"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSeleccion}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F7F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======================= PESTAÑAS ======================= -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,14,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoSuave}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" Padding="16,9" Margin="0,0,4,0"
                                CornerRadius="9,9,0,0" BorderThickness="0,0,0,2.5"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFEDE2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimario}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= BARRAS DE DESPLAZAMIENTO ======================= -->
        <Style x:Key="PulgarScroll" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Background="#CDC8B6" CornerRadius="4" Margin="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#ADA694"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PulgarScroll}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="11"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource PulgarScroll}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======================= AYUDAS EMERGENTES ======================= -->
        <Style TargetType="ToolTip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource BrushLateral}" CornerRadius="7" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

    </Application.Resources>
</Application>
