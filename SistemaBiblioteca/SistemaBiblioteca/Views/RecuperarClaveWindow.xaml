<Window x:Class="RecuperarClaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaBiblioteca"
        Title="Recuperar contraseña — Biblioteca Alejandría" Icon="{StaticResource IconoApp}"
        Height="560" Width="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <local:LogoBiblioteca Tamano="34"/>
                <TextBlock Text="Recuperar contraseña" Style="{StaticResource TituloPagina}"
                           Margin="11,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="lblPaso" Style="{StaticResource Subtitulo}" Margin="0,7,0,0"
                       TextWrapping="Wrap" Text="Escribe tu usuario para empezar."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel x:Name="panelFormulario" Margin="0,0,8,0">

                <!-- ===== PASO 1: identificar la cuenta ===== -->
                <StackPanel x:Name="pasoUsuario">
                    <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" MaxLength="30"/>
                    <Button x:Name="btnBuscar" Content="Continuar" Style="{StaticResource BotonPrimario}"
                            Height="40" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- ===== PASO 2a: pregunta de seguridad ===== -->
                <StackPanel x:Name="pasoPregunta" Visibility="Collapsed">
                    <Border Background="{StaticResource BrushPrimarioSuave}" CornerRadius="10" Padding="13,11">
                        <StackPanel>
                            <TextBlock Text="🔐  TU PREGUNTA DE SEGURIDAD" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource BrushPrimario}"/>
                            <TextBlock x:Name="lblPregunta" FontSize="13" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Foreground="{StaticResource BrushTexto}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RESPUESTA" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" MaxLength="60"/>

                    <Button x:Name="btnVerificarRespuesta" Content="Verificar respuesta"
                            Style="{StaticResource BotonPrimario}" Height="40" Margin="0,14,0,0"/>

                    <TextBlock x:Name="pnlUsarCorreo" HorizontalAlignment="Center" Margin="0,10,0,0"
                               FontSize="12">
                        <Hyperlink x:Name="lnkUsarCorreo" Style="{StaticResource EnlaceSutil}">Prefiero recibir un código por correo</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- ===== PASO 2b: código al correo ===== -->
                <StackPanel x:Name="pasoCodigo" Visibility="Collapsed">
                    <Border Background="{StaticResource BrushAcentoSuave}" CornerRadius="10" Padding="13,11">
                        <StackPanel>
                            <TextBlock Text="✉  CÓDIGO DE VERIFICACIÓN" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#8A6D0B"/>
                            <TextBlock x:Name="lblAvisoCodigo" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Foreground="{StaticResource BrushTexto}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CÓDIGO DE 6 DÍGITOS" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtCodigo" Style="{StaticResource CajaTexto}" MaxLength="6"
                             FontFamily="Consolas" FontSize="18"/>

                    <Button x:Name="btnVerificarCodigo" Content="Verificar código"
                            Style="{StaticResource BotonPrimario}" Height="40" Margin="0,14,0,0"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12">
                        <Hyperlink x:Name="lnkReenviar" Style="{StaticResource EnlaceSutil}">Enviar otro código</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- ===== PASO 3: nueva contraseña ===== -->
                <StackPanel x:Name="pasoClave" Visibility="Collapsed">
                    <Border Background="{StaticResource BrushExitoSuave}" CornerRadius="10" Padding="13,11">
                        <TextBlock Text="✅  Identidad verificada. Elige tu nueva contraseña."
                                   FontSize="12.5" Foreground="#166534" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                    <local:CajaClaveVisible x:Name="txtNueva" Height="38"/>

                    <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                    <local:CajaClaveVisible x:Name="txtNueva2" Height="38"/>

                    <TextBlock Text="Mínimo 6 caracteres, combinando letras y números."
                               FontSize="11" Foreground="{StaticResource BrushTextoSuave}" Margin="0,7,0,0"/>

                    <Button x:Name="btnGuardarClave" Content="Guardar contraseña"
                            Style="{StaticResource BotonExito}" Height="42" Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource BotonGris}"
                Width="110" Height="40" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True"/>
    </Grid>
</Window>
