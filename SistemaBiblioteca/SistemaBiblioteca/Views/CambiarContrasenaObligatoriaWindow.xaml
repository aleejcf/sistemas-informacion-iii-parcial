<Window x:Class="CambiarContrasenaObligatoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaBiblioteca"
        Title="Cambia tu contraseña — Biblioteca Alejandría" Icon="{StaticResource IconoApp}"
        Height="440" Width="450" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <StackPanel x:Name="panelFormulario" Margin="30,26">
        <StackPanel Orientation="Horizontal">
            <local:LogoBiblioteca Tamano="34"/>
            <TextBlock Text="Cambia tu contraseña" Style="{StaticResource TituloPagina}"
                       Margin="11,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Background="{StaticResource BrushAdvSuave}" CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#92400E">
                Tu cuenta se creó con una contraseña temporal. Por seguridad, tienes que
                cambiarla antes de entrar al sistema.
            </TextBlock>
        </Border>

        <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
        <local:CajaClaveVisible x:Name="txtNueva" Height="38"/>

        <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
        <local:CajaClaveVisible x:Name="txtNueva2" Height="38"/>

        <TextBlock Text="Mínimo 6 caracteres, combinando letras y números."
                   FontSize="11" Foreground="{StaticResource BrushTextoSuave}" Margin="0,7,0,0"/>

        <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <Button x:Name="btnGuardar" Content="Guardar y entrar" Style="{StaticResource BotonExito}"
                Height="42" Margin="0,20,0,0" IsDefault="True"/>

        <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="12">
            <Hyperlink x:Name="lnkSalir" Style="{StaticResource EnlaceSutil}">Cancelar y cerrar sesión</Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
