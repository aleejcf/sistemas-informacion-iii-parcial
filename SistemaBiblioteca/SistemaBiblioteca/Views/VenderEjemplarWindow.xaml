<Window x:Class="VenderEjemplarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaBiblioteca"
        Title="Vender ejemplar — Biblioteca Alejandría" Icon="{StaticResource IconoApp}"
        Height="440" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <StackPanel x:Name="panelFormulario" Margin="30,26">
        <StackPanel Orientation="Horizontal">
            <local:LogoBiblioteca Tamano="34"/>
            <TextBlock Text="Vender ejemplar" Style="{StaticResource TituloPagina}"
                       Margin="11,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Background="#F7F5EC" CornerRadius="10" Padding="14,12" Margin="0,18,0,0"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="lblTitulo" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock x:Name="lblCodigo" Style="{StaticResource Codigo}" FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Text="PRECIO DE VENTA (L)" Style="{StaticResource Etiqueta}" Margin="0,16,0,0"/>
        <TextBox x:Name="txtPrecio" Style="{StaticResource CajaTexto}" Height="38"/>

        <TextBlock Text="COMPRADOR (OPCIONAL)" Style="{StaticResource Etiqueta}"/>
        <TextBox x:Name="txtComprador" Style="{StaticResource CajaTexto}" Height="38" MaxLength="80"/>

        <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancelar" Grid.Column="0" Content="Cancelar" Style="{StaticResource BotonGris}"
                    Height="42" Margin="0,0,5,0" IsCancel="True"/>
            <Button x:Name="btnVender" Grid.Column="1" Content="💲 Vender" Style="{StaticResource BotonExito}"
                    Height="42" Margin="5,0,0,0" IsDefault="True"/>
        </Grid>
    </StackPanel>
</Window>
