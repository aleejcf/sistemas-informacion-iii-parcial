<Window x:Class="RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaBiblioteca"
        Title="Crear cuenta — Biblioteca Alejandría" Icon="{StaticResource IconoApp}"
        Height="670" Width="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">

    <!-- El formulario se reparte a lo ancho en tres bloques (datos, acceso y
         recuperación) en vez de apilarse en una columna con barra de
         desplazamiento: así se ve completo de una sola mirada. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ ENCABEZADO ══════════ -->
        <Border Grid.Row="0" Background="{StaticResource BrushLateral}" Padding="30,20">
            <DockPanel>
                <!-- Solo el rol que va a tener la cuenta; el porqué no le aporta
                     nada a quien está llenando el formulario -->
                <Border DockPanel.Dock="Right" Background="#1E4433" CornerRadius="8" Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="lblAvisoRol" FontSize="11.5" Foreground="#B6CEBF"/>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <local:LogoBiblioteca Tamano="40" VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Crear cuenta" FontSize="21" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Una cuenta del personal que opera la biblioteca"
                                   FontSize="11.5" Foreground="#9DBBAA" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════ CUERPO ══════════ -->
        <Grid x:Name="panelFormulario" Grid.Row="1" Margin="30,22,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ····· Bloque 1: quién eres ····· -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="👤   TUS DATOS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushPrimario}"/>

                    <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtNombre" Style="{StaticResource CajaTexto}" MaxLength="80"/>

                    <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtEmail" Style="{StaticResource CajaTexto}" MaxLength="80"/>

                    <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" MaxLength="30"/>
                    <TextBlock Text="De 4 a 30 caracteres: letras, números o guion bajo."
                               FontSize="10.5" Margin="0,5,0,0"
                               Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>

            <!-- ····· Bloque 2: cómo entras ····· -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="🔒   TU ACCESO" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushPrimario}"/>

                    <TextBlock Text="CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                    <local:CajaClaveVisible x:Name="txtClave" Height="38"/>

                    <!-- Medidor de fuerza: retroalimentación inmediata mientras se escribe -->
                    <ProgressBar x:Name="barraFuerza" Style="{StaticResource BarraAcervo}"
                                 Height="5" Value="0" Margin="0,8,0,0"/>
                    <TextBlock x:Name="lblFuerza" FontSize="10.5" Margin="0,5,0,0"
                               Foreground="{StaticResource BrushTextoSuave}"
                               Text="Mínimo 6 caracteres, combinando letras y números."/>

                    <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                    <local:CajaClaveVisible x:Name="txtClave2" Height="38"/>
                </StackPanel>
            </Border>

            <!-- ····· Bloque 3: cómo la recuperas ····· -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="🔐   RECUPERACIÓN DE LA CUENTA" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushPrimario}"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="PREGUNTA DE SEGURIDAD" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="cboPregunta" IsEditable="True"
                                      Tag="Elige o escribe una pregunta"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="RESPUESTA" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" MaxLength="60"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="lblError" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Foreground="{StaticResource BrushPeligro}" FontSize="12.5" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="2,14,0,0" VerticalAlignment="Top"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- ══════════ ACCIONES ══════════ -->
        <Border Grid.Row="2" Background="White" Padding="30,16"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonGris}"
                        Width="120" Height="42" Margin="0,0,10,0" IsCancel="True"/>
                <Button x:Name="btnCrear" Content="Crear cuenta" Style="{StaticResource BotonPrimario}"
                        Width="170" Height="42" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
