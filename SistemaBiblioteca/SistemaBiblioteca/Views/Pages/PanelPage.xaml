<UserControl x:Class="PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= INDICADORES ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="15,13">
                <StackPanel>
                    <TextBlock x:Name="lblTitulos" Text="0" Style="{StaticResource Cifra}"/>
                    <TextBlock Text="Títulos en catálogo" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="5,0" Padding="15,13">
                <StackPanel>
                    <TextBlock x:Name="lblEjemplares" Text="0" Style="{StaticResource Cifra}"/>
                    <TextBlock Text="Ejemplares" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                    <ProgressBar x:Name="barraAcervo" Style="{StaticResource BarraAcervo}" Margin="0,7,0,0"/>
                    <TextBlock x:Name="lblAcervoDetalle" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="5,0" Padding="15,13">
                <StackPanel>
                    <TextBlock x:Name="lblActivos" Text="0" Style="{StaticResource Cifra}"
                               Foreground="{StaticResource BrushPrimario}"/>
                    <TextBlock Text="Préstamos activos" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" x:Name="tarjetaVencidos" Style="{StaticResource TarjetaClicable}"
                    Margin="5,0" Padding="15,13" ToolTip="Ver los préstamos vencidos">
                <StackPanel>
                    <TextBlock x:Name="lblVencidos" Text="0" Style="{StaticResource Cifra}"
                               Foreground="{StaticResource BrushPeligro}"/>
                    <TextBlock Text="Vencidos" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="lblVencenHoy" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushAdvertencia}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Tarjeta}" Margin="5,0" Padding="15,13">
                <StackPanel>
                    <TextBlock x:Name="lblSocios" Text="0" Style="{StaticResource Cifra}"/>
                    <TextBlock Text="Socios activos" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="lblReservas" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="5" x:Name="tarjetaMultas" Style="{StaticResource TarjetaClicable}"
                    Margin="5,0,0,0" Padding="15,13" ToolTip="Ir a la página de multas">
                <StackPanel>
                    <TextBlock x:Name="lblMultas" Text="L 0.00" Style="{StaticResource Cifra}"
                               FontSize="22" Foreground="{StaticResource BrushAcento}"/>
                    <TextBlock Text="Multas por cobrar" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="lblCobradoHoy" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushExito}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= CUERPO ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- ····· Izquierda ····· -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Movimiento diario: préstamos contra devoluciones -->
                <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="3"
                                        Background="{StaticResource BrushPrimario}" VerticalAlignment="Center"/>
                                <TextBlock Text="Préstamos" FontSize="11" Margin="5,0,14,0"
                                           Foreground="{StaticResource BrushTextoSuave}" VerticalAlignment="Center"/>
                                <Border Width="10" Height="10" CornerRadius="3"
                                        Background="{StaticResource BrushAcento}" VerticalAlignment="Center"/>
                                <TextBlock Text="Devoluciones" FontSize="11" Margin="5,0,0,0"
                                           Foreground="{StaticResource BrushTextoSuave}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Movimiento de los últimos 14 días"
                                           Style="{StaticResource TituloTarjeta}"/>
                                <TextBlock Text="Cuántos libros salieron y cuántos volvieron cada día"
                                           Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Gráfica de columnas. Las alturas se calculan en el
                             code-behind y se agregan como columnas a la tabla. -->
                        <ItemsControl x:Name="graficaMovimiento" Height="150" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <Border Width="11" Height="{Binding alto_prestamos}"
                                                    CornerRadius="3,3,0,0" Margin="0,0,2,0"
                                                    Background="{StaticResource BrushPrimario}"
                                                    ToolTip="{Binding prestamos, StringFormat='{}{0} préstamos'}"/>
                                            <Border Width="11" Height="{Binding alto_devoluciones}"
                                                    CornerRadius="3,3,0,0"
                                                    Background="{StaticResource BrushAcento}"
                                                    ToolTip="{Binding devoluciones, StringFormat='{}{0} devoluciones'}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding etiqueta_dia}" FontSize="9.5"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{StaticResource BrushTextoSuave}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Los títulos más pedidos -->
                <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Los más pedidos" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Títulos con más préstamos en los últimos seis meses"
                                       Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ItemsControl x:Name="listaMasPrestados" Grid.Row="1" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding titulo}" Style="{StaticResource TituloLibro}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Margin="0,1,0,0"
                                                       Foreground="{StaticResource BrushTextoSuave}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding autor, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding categoria, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="1" Height="9" CornerRadius="4"
                                                Background="#E6E2D5" HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center">
                                            <Border CornerRadius="4" HorizontalAlignment="Left"
                                                    Background="{StaticResource BrushPrimario}"
                                                    Width="{Binding porcentaje,
                                                            Converter={StaticResource PorcentajeAAncho},
                                                            ConverterParameter=230}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding veces_prestado}"
                                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource BrushTexto}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ····· Derecha ····· -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mora -->
                <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button x:Name="btnVerVencidos" DockPanel.Dock="Right" Content="Ver todos"
                                    Style="{StaticResource BotonPlano}" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="Libros con retraso" Style="{StaticResource TituloTarjeta}"/>
                                <TextBlock Text="A quién hay que llamar hoy"
                                           Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="listaVencidos">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushPeligroSuave}"
                                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding socio}" FontWeight="SemiBold"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource BrushTexto}"/>
                                                        <TextBlock Text="{Binding titulos}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource BrushTextoSuave}"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock FontSize="10.5" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource BrushTextoSuave}">
                                                            <Run Text="{Binding codigo, Mode=OneWay}"/><Run Text=" · Tel. "/><Run Text="{Binding telefono, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="Bold" FontSize="14"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource BrushPeligro}">
                                                            <Run Text="{Binding dias_retraso, Mode=OneWay}"/><Run Text=" d"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding mora_estimada, StringFormat='L {0:N2}'}"
                                                                   FontSize="11" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource BrushTextoSuave}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel x:Name="pnlSinVencidos" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="✅" FontSize="30" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ningún libro con retraso." Style="{StaticResource Subtitulo}"
                                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Por vencer -->
                <Border Grid.Row="1" Style="{StaticResource Tarjeta}" MaxHeight="270">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Vencen pronto" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Los próximos tres días" Style="{StaticResource Subtitulo}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="listaPorVencer">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding socio}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTexto}"/>
                                                    <TextBlock Text="{Binding titulos}" FontSize="10.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource BrushTextoSuave}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource Insignia}"
                                                        Background="{StaticResource BrushAdvSuave}">
                                                    <TextBlock Style="{StaticResource TextoInsignia}"
                                                               Foreground="{StaticResource BrushAdvertencia}"
                                                               Text="{Binding dias_restantes,
                                                                      Converter={StaticResource DiasRestantesATexto}}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="lblSinPorVencer" Text="Nada vence en los próximos días."
                                       Style="{StaticResource Subtitulo}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
