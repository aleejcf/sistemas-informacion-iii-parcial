<UserControl x:Class="PrestamosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= INDICADORES ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,6,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblIndTotal" Text="0" Style="{StaticResource Cifra}"/>
                    <TextBlock Text="Préstamos en la lista" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="6,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblIndActivos" Text="0" Style="{StaticResource Cifra}"
                               Foreground="{StaticResource BrushPrimario}"/>
                    <TextBlock Text="Activos" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="6,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblIndVencidos" Text="0" Style="{StaticResource Cifra}"
                               Foreground="{StaticResource BrushPeligro}"/>
                    <TextBlock Text="Vencidos" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Tarjeta}" Margin="6,0,0,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblIndEjemplares" Text="0" Style="{StaticResource Cifra}"
                               Foreground="{StaticResource BrushAcento}"/>
                    <TextBlock Text="Ejemplares fuera de la biblioteca" Style="{StaticResource Subtitulo}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LISTA ================= -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Movimiento de préstamos"
                               Style="{StaticResource TituloTarjeta}"/>

                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="txtBuscar" Style="{StaticResource CajaTexto}"/>
                            <TextBlock Text="Folio, socio, código o título…" FontSize="13.5"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                                       Foreground="{StaticResource BrushTextoSuave}"
                                       Visibility="{Binding Text, ElementName=txtBuscar,
                                                    Converter={StaticResource VacioAVisible}}"/>
                        </Grid>

                        <ComboBox x:Name="cboSituacion" Grid.Column="1" Margin="0,0,8,0"
                                  Tag="Todas las situaciones"/>
                        <DatePicker x:Name="dtpDesde" Grid.Column="2" Margin="0,0,8,0"
                                    ToolTip="Mostrar solo los préstamos hechos desde esta fecha"/>
                        <Button x:Name="btnLimpiar" Grid.Column="3" Content="Limpiar"
                                Style="{StaticResource BotonPlano}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="dgPrestamos">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Folio" Width="98">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding codigo}" Style="{StaticResource Codigo}"
                                                       FontSize="12.5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Socio" Binding="{Binding socio}" Width="150"/>
                                <DataGridTextColumn Header="Títulos" Binding="{Binding titulos}"
                                                    Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Prestado" Width="90"
                                                    Binding="{Binding fecha_prestamo, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                <DataGridTextColumn Header="Vence" Width="90"
                                                    Binding="{Binding fecha_vencimiento, StringFormat='{}{0:dd/MM/yyyy}'}"/>

                                <DataGridTemplateColumn Header="Ejemplares" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontSize="12">
                                                <Run Text="{Binding devueltos, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding total_ejemplares, Mode=OneWay}"/><Run Text=" devueltos"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Situación" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding situacion,
                                                                Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding situacion}"
                                                           Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding situacion,
                                                                       Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="pnlVacio" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" Background="White" Margin="1,40,1,1">
                            <TextBlock Text="📖" FontSize="34" HorizontalAlignment="Center" Opacity="0.35"/>
                            <TextBlock Text="No hay préstamos que coincidan con la búsqueda."
                                       Style="{StaticResource Subtitulo}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= DETALLE ================= -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
                <Grid>
                    <!-- Sin selección -->
                    <StackPanel x:Name="pnlSinSeleccion" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="34" HorizontalAlignment="Center" Opacity="0.35"/>
                        <TextBlock Text="Selecciona un préstamo de la lista para devolver, renovar o consultarlo."
                                   Style="{StaticResource Subtitulo}" Margin="0,10,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="250"/>
                    </StackPanel>

                    <Grid x:Name="pnlDetalle" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera -->
                        <StackPanel Grid.Row="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" x:Name="pnlSituacion"
                                        Style="{StaticResource Insignia}" VerticalAlignment="Top">
                                    <TextBlock x:Name="lblSituacion" Style="{StaticResource TextoInsignia}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="lblFolio" Style="{StaticResource Codigo}" FontSize="19"/>
                                    <TextBlock x:Name="lblSocio" Style="{StaticResource TituloTarjeta}"
                                               FontSize="14" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblSocioDatos" Style="{StaticResource Subtitulo}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PRESTADO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblFechaPrestamo" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTexto}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="VENCE" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblFechaVence" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTexto}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PLAZO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblPlazo" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Mora proyectada -->
                            <Border x:Name="pnlMora" Visibility="Collapsed" Margin="0,14,0,0"
                                    Background="{StaticResource BrushPeligroSuave}" CornerRadius="10"
                                    Padding="13,11">
                                <StackPanel>
                                    <TextBlock x:Name="lblMoraTitulo" FontSize="12.5" FontWeight="Bold"
                                               Foreground="{StaticResource BrushPeligro}"/>
                                    <TextBlock x:Name="lblMoraDetalle" FontSize="11.5" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{StaticResource BrushPeligro}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="pnlObservacion" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="#F7F5EC" CornerRadius="10" Padding="12,10"
                                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                                <TextBlock x:Name="lblObservacion" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTextoSuave}"/>
                            </Border>
                        </StackPanel>

                        <!-- Ejemplares -->
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <Button x:Name="btnMarcarTodos" DockPanel.Dock="Right" Content="Marcar todos"
                                        Style="{StaticResource BotonPlano}"/>
                                <TextBlock x:Name="lblTituloEjemplares" Text="EJEMPLARES"
                                           Style="{StaticResource Etiqueta}" Margin="0,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <ItemsControl x:Name="listaEjemplares">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F5EC" CornerRadius="10" Padding="12,10"
                                                    Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorde}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <CheckBox Grid.Row="0"
                                                              IsChecked="{Binding Marcada, Mode=TwoWay}">
                                                        <StackPanel Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding Titulo}"
                                                                       Style="{StaticResource TituloLibro}"
                                                                       FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding CodigoBarras}"
                                                                       FontFamily="Consolas, Courier New"
                                                                       FontSize="10.5" Margin="0,2,0,0"
                                                                       Foreground="{StaticResource BrushTextoSuave}"/>
                                                        </StackPanel>
                                                    </CheckBox>

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                                Margin="24,8,0,0">
                                                        <TextBlock Text="Vuelve en estado:" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Foreground="{StaticResource BrushTextoSuave}"/>
                                                        <ComboBox Width="150" Height="30" FontSize="12"
                                                                  ItemsSource="{Binding DataContext.CondicionesDevolucion,
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding Condicion, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Acciones -->
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button x:Name="btnDevolver" Content="✅  Registrar devolución"
                                    Style="{StaticResource BotonExito}" Height="42"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnRenovar" Grid.Column="0" Content="🔁  Renovar"
                                        Style="{StaticResource BotonContorno}" Height="38" Margin="0,0,4,0"/>
                                <Button x:Name="btnCancelar" Grid.Column="1" Content="🗑  Cancelar"
                                        Style="{StaticResource BotonPeligro}" Height="38" Margin="4,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="lblSinPermiso" Style="{StaticResource Subtitulo}"
                                       Text="Solo un administrador puede cancelar un préstamo."
                                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                                       Foreground="{StaticResource BrushAdvertencia}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
