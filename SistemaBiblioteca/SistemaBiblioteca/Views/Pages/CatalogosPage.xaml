<UserControl x:Class="CatalogosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="pnlAvisoPermiso" Style="{StaticResource Tarjeta}"
                Background="{StaticResource BrushAdvSuave}" Padding="16,13" Margin="0,0,0,14"
                Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#92400E"
                       Text="Estos catálogos son la configuración del acervo y de la política de préstamo. Puedes consultarlos, pero solo un administrador los modifica."/>
        </Border>

        <TabControl Grid.Row="1" x:Name="pestanas">

            <!-- ======================= AUTORES ======================= -->
            <TabItem Header="Autores">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBox x:Name="txtBuscarAutor" Style="{StaticResource CajaTexto}"/>
                                <TextBlock Text="Buscar autor por nombre o nacionalidad…" FontSize="13.5"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                                           Foreground="{StaticResource BrushTextoSuave}"
                                           Visibility="{Binding Text, ElementName=txtBuscarAutor,
                                                        Converter={StaticResource VacioAVisible}}"/>
                            </Grid>
                            <DataGrid x:Name="dgAutores" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Autor" Binding="{Binding nombre}"
                                                        Width="*" MinWidth="180"/>
                                    <DataGridTextColumn Header="Nacionalidad" Binding="{Binding nacionalidad}"
                                                        Width="170"/>
                                    <DataGridTextColumn Header="Títulos" Binding="{Binding titulos}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="lblFormAutor" Text="Nuevo autor"
                                       Style="{StaticResource TituloTarjeta}"/>
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtAutorNombre" Style="{StaticResource CajaTexto}" MaxLength="60"/>
                                <TextBlock Text="NACIONALIDAD" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtAutorPais" Style="{StaticResource CajaTexto}" MaxLength="40"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnAutorNuevo" Grid.Column="0" Content="➕"
                                        Style="{StaticResource BotonGris}" Height="38" Margin="0,0,4,0"/>
                                <Button x:Name="btnAutorGuardar" Grid.Column="1" Content="💾"
                                        Style="{StaticResource BotonExito}" Height="38" Margin="4,0"/>
                                <Button x:Name="btnAutorEliminar" Grid.Column="2" Content="🗑"
                                        Style="{StaticResource BotonPeligro}" Height="38" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= EDITORIALES ======================= -->
            <TabItem Header="Editoriales">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBox x:Name="txtBuscarEditorial" Style="{StaticResource CajaTexto}"/>
                                <TextBlock Text="Buscar editorial por nombre o país…" FontSize="13.5"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                                           Foreground="{StaticResource BrushTextoSuave}"
                                           Visibility="{Binding Text, ElementName=txtBuscarEditorial,
                                                        Converter={StaticResource VacioAVisible}}"/>
                            </Grid>
                            <DataGrid x:Name="dgEditoriales" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Editorial" Binding="{Binding nombre}"
                                                        Width="*" MinWidth="180"/>
                                    <DataGridTextColumn Header="País" Binding="{Binding pais}" Width="170"/>
                                    <DataGridTextColumn Header="Títulos" Binding="{Binding titulos}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="lblFormEditorial" Text="Nueva editorial"
                                       Style="{StaticResource TituloTarjeta}"/>
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtEditorialNombre" Style="{StaticResource CajaTexto}" MaxLength="60"/>
                                <TextBlock Text="PAÍS" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtEditorialPais" Style="{StaticResource CajaTexto}" MaxLength="40"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnEditorialNuevo" Grid.Column="0" Content="➕"
                                        Style="{StaticResource BotonGris}" Height="38" Margin="0,0,4,0"/>
                                <Button x:Name="btnEditorialGuardar" Grid.Column="1" Content="💾"
                                        Style="{StaticResource BotonExito}" Height="38" Margin="4,0"/>
                                <Button x:Name="btnEditorialEliminar" Grid.Column="2" Content="🗑"
                                        Style="{StaticResource BotonPeligro}" Height="38" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= CATEGORÍAS ======================= -->
            <TabItem Header="Categorías">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBox x:Name="txtBuscarCategoria" Style="{StaticResource CajaTexto}"/>
                                <TextBlock Text="Buscar categoría por nombre o código Dewey…" FontSize="13.5"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                                           Foreground="{StaticResource BrushTextoSuave}"
                                           Visibility="{Binding Text, ElementName=txtBuscarCategoria,
                                                        Converter={StaticResource VacioAVisible}}"/>
                            </Grid>
                            <DataGrid x:Name="dgCategorias" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Dewey" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding codigo_dewey}"
                                                           Style="{StaticResource Codigo}" FontSize="12"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Categoría" Binding="{Binding nombre}" Width="160"/>
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding descripcion}"
                                                        Width="*" MinWidth="180"/>
                                    <DataGridTextColumn Header="Títulos" Binding="{Binding titulos}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="lblFormCategoria" Text="Nueva categoría"
                                       Style="{StaticResource TituloTarjeta}"/>
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtCategoriaNombre" Style="{StaticResource CajaTexto}" MaxLength="40"/>
                                <TextBlock Text="CÓDIGO DEWEY" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtCategoriaDewey" Style="{StaticResource CajaTexto}" MaxLength="3"
                                         ToolTip="Los tres dígitos que van en el lomo del libro"/>
                                <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtCategoriaDescripcion" Style="{StaticResource CajaTextoLarga}"
                                         MaxLength="120"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnCategoriaNuevo" Grid.Column="0" Content="➕"
                                        Style="{StaticResource BotonGris}" Height="38" Margin="0,0,4,0"/>
                                <Button x:Name="btnCategoriaGuardar" Grid.Column="1" Content="💾"
                                        Style="{StaticResource BotonExito}" Height="38" Margin="4,0"/>
                                <Button x:Name="btnCategoriaEliminar" Grid.Column="2" Content="🗑"
                                        Style="{StaticResource BotonPeligro}" Height="38" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= TIPOS DE SOCIO ======================= -->
            <TabItem Header="Tipos de socio">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="La política de préstamo" Style="{StaticResource TituloTarjeta}"/>
                                <TextBlock Text="Cuántos ejemplares, por cuántos días y con qué multa"
                                           Style="{StaticResource Subtitulo}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="dgTipos" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding nombre}"
                                                        Width="*" MinWidth="140"/>
                                    <DataGridTextColumn Header="Máx. ejemplares" Binding="{Binding max_prestamos}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Días de plazo" Binding="{Binding dias_prestamo}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Multa diaria" Width="110"
                                                        Binding="{Binding multa_diaria, StringFormat='L {0:N2}'}"/>
                                    <DataGridTextColumn Header="Socios" Binding="{Binding socios}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="lblFormTipo" Text="Nuevo tipo de socio"
                                       Style="{StaticResource TituloTarjeta}"/>
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtTipoNombre" Style="{StaticResource CajaTexto}" MaxLength="20"/>
                                <TextBlock Text="MÁXIMO DE EJEMPLARES A LA VEZ" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtTipoMax" Style="{StaticResource CajaTexto}" MaxLength="2"/>
                                <TextBlock Text="DÍAS DE PLAZO" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtTipoDias" Style="{StaticResource CajaTexto}" MaxLength="2"/>
                                <TextBlock Text="MULTA POR DÍA DE RETRASO (L)" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtTipoMulta" Style="{StaticResource CajaTexto}" MaxLength="8"/>
                                <TextBlock x:Name="lblEjemploMulta" FontSize="10.5" Margin="0,7,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource BrushTextoSuave}"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnTipoNuevo" Grid.Column="0" Content="➕"
                                        Style="{StaticResource BotonGris}" Height="38" Margin="0,0,4,0"/>
                                <Button x:Name="btnTipoGuardar" Grid.Column="1" Content="💾"
                                        Style="{StaticResource BotonExito}" Height="38" Margin="4,0"/>
                                <Button x:Name="btnTipoEliminar" Grid.Column="2" Content="🗑"
                                        Style="{StaticResource BotonPeligro}" Height="38" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
