<UserControl x:Class="ReservasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Tarjeta}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkHistorial" Content="Ver también las cerradas"
                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="btnCancelar" Content="🗑  Cancelar reserva"
                            Style="{StaticResource BotonPeligro}" Padding="14,8"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Fila de espera" Style="{StaticResource TituloTarjeta}"/>
                    <TextBlock x:Name="lblSubtitulo" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"
                               Text="Quién está esperando por un título sin copias libres"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <DataGrid x:Name="dgReservas">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Título" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding titulo}"
                                                   Style="{StaticResource TituloLibro}" FontSize="13"/>
                                        <TextBlock FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{StaticResource BrushTextoSuave}">
                                            <Run Text="{Binding autor, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding idlibro, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Socio" Binding="{Binding socio}" Width="180"/>
                        <DataGridTextColumn Header="Correo" Binding="{Binding email}" Width="180"/>
                        <DataGridTextColumn Header="Reservado" Width="100"
                                            Binding="{Binding fecha_reserva, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                        <DataGridTextColumn Header="Expira" Width="100"
                                            Binding="{Binding fecha_expira, StringFormat='{}{0:dd/MM/yyyy}'}"/>

                        <DataGridTemplateColumn Header="Vigencia" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Text="{Binding dias_restantes,
                                                      Converter={StaticResource DiasRestantesATexto}}"
                                               Foreground="{StaticResource BrushTextoSuave}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="¿Ya hay copias?" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushExito}"
                                                   Visibility="{Binding disponibles,
                                                                Converter={StaticResource ConteoAVisible}}">
                                            <Run Text="✅ "/><Run Text="{Binding disponibles, Mode=OneWay}"/><Run Text=" disponibles"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Insignia}"
                                            Background="{Binding estado,
                                                        Converter={StaticResource EstadoAColorFondo}}">
                                        <TextBlock Text="{Binding estado}"
                                                   Style="{StaticResource TextoInsignia}"
                                                   Foreground="{Binding estado,
                                                               Converter={StaticResource EstadoAColor}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="pnlVacio" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" Background="White" Margin="1,40,1,1">
                    <TextBlock Text="🔖" FontSize="34" HorizontalAlignment="Center" Opacity="0.35"/>
                    <TextBlock Text="No hay nadie esperando por un título."
                               Style="{StaticResource Subtitulo}" Margin="0,8,0,0"/>
                    <TextBlock Text="Las reservas se crean desde el catálogo, en los títulos sin copias libres."
                               Style="{StaticResource Subtitulo}" Margin="0,4,0,0" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
