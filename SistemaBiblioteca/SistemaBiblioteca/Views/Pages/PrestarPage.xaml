<UserControl x:Class="PrestarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= PASOS ================= -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border x:Name="paso1" Style="{StaticResource PasoAsistenteActivo}">
                <TextBlock x:Name="txtPaso1" Text="1  ·  Socio" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>
            <Border x:Name="paso2" Style="{StaticResource PasoAsistente}">
                <TextBlock x:Name="txtPaso2" Text="2  ·  Libros" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextoSuave}"/>
            </Border>
            <Border x:Name="paso3" Style="{StaticResource PasoAsistente}">
                <TextBlock x:Name="txtPaso3" Text="3  ·  Confirmar" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextoSuave}"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ PASO ACTIVO ═══════════ -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <Grid>

                    <!-- ····· PASO 1: elegir el socio ····· -->
                    <Grid x:Name="panelPaso1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="¿Quién se lleva los libros?" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Busca por nombre, código de socio, identidad o correo"
                                       Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,12">
                            <TextBox x:Name="txtBuscarSocio" Style="{StaticResource CajaTexto}" Height="42"/>
                            <TextBlock Text="Escribe el nombre o el código del socio…" FontSize="14"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{StaticResource BrushTextoSuave}"
                                       Visibility="{Binding Text, ElementName=txtBuscarSocio,
                                                    Converter={StaticResource VacioAVisible}}"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="dgSocios">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Código" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding idsocio}" Style="{StaticResource Codigo}"
                                                           FontSize="12"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Socio" Binding="{Binding nombre_completo}"
                                                        Width="*" MinWidth="160"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding tipo_socio}" Width="110"/>
                                    <DataGridTextColumn Header="Afuera" Width="70"
                                                        Binding="{Binding ejemplares_afuera}"/>
                                    <DataGridTextColumn Header="Cupo" Width="60"
                                                        Binding="{Binding cupo_disponible}"/>
                                    <DataGridTextColumn Header="Debe" Width="90"
                                                        Binding="{Binding monto_adeudado, StringFormat='L {0:N2}'}"/>
                                    <DataGridTemplateColumn Header="Situación" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Insignia}"
                                                        Background="{Binding situacion,
                                                            Converter={StaticResource EstadoAColorFondo}}">
                                                    <TextBlock Text="{Binding situacion}"
                                                               Style="{StaticResource TextoInsignia}"
                                                               Foreground="{Binding situacion,
                                                                   Converter={StaticResource EstadoAColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel x:Name="pnlSinSocios" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center"
                                           Foreground="{StaticResource BrushBorde}"/>
                                <TextBlock Text="Ningún socio coincide con la búsqueda."
                                           Style="{StaticResource Subtitulo}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ····· PASO 2: elegir los ejemplares ····· -->
                    <Grid x:Name="panelPaso2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button x:Name="btnVolverPaso1" DockPanel.Dock="Right" Content="⟵  Cambiar socio"
                                    Style="{StaticResource BotonPlano}" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="¿Qué libros se lleva?" Style="{StaticResource TituloTarjeta}"/>
                                <TextBlock Text="Busca el título y elige la copia física que le entregas"
                                           Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <TextBox x:Name="txtBuscarLibro" Style="{StaticResource CajaTexto}" Height="42"/>
                                <TextBlock Text="Título, autor, ISBN o código de barras…" FontSize="14"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"
                                           Foreground="{StaticResource BrushTextoSuave}"
                                           Visibility="{Binding Text, ElementName=txtBuscarLibro,
                                                        Converter={StaticResource VacioAVisible}}"/>
                            </Grid>

                            <ComboBox x:Name="cboCategoria" Grid.Column="1" Height="42" Margin="0,0,8,0"
                                      Tag="Todas las categorías"
                                      DisplayMemberPath="etiqueta" SelectedValuePath="idcategoria"/>

                            <Button x:Name="btnLimpiarLibro" Grid.Column="2" Content="Limpiar"
                                    Style="{StaticResource BotonPlano}"/>
                        </Grid>

                        <DataGrid x:Name="dgLibros" Grid.Row="2">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Título" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding titulo}"
                                                           Style="{StaticResource TituloLibro}" FontSize="13"/>
                                                <TextBlock Text="{Binding autor}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextoSuave}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding categoria}" Width="130"/>
                                <DataGridTextColumn Header="Año" Binding="{Binding anio_publicacion}" Width="60"/>
                                <DataGridTemplateColumn Header="Acervo" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <ProgressBar Style="{StaticResource BarraAcervo}"
                                                             Value="{Binding porcentaje_prestado, Mode=OneWay}"/>
                                                <TextBlock FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource BrushTextoSuave}">
                                                    <Run Text="{Binding disponibles, Mode=OneWay}"/><Run Text=" libres de "/><Run Text="{Binding total_ejemplares, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Estado" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding disponibilidad,
                                                                Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding disponibilidad}"
                                                           Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding disponibilidad,
                                                                       Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Copias físicas del título seleccionado -->
                        <Border Grid.Row="3" Background="#F7F5EC" CornerRadius="11" Padding="14,12"
                                Margin="0,12,0,0" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="lblTituloEjemplares" Style="{StaticResource Etiqueta}"
                                           Margin="0,0,0,7" Text="COPIAS DISPONIBLES"/>

                                <ItemsControl x:Name="listaEjemplares" MaxHeight="96">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BotonContorno}" Margin="0,0,7,7"
                                                    Padding="12,7" FontSize="12"
                                                    Click="AgregarEjemplar_Click" Tag="{Binding}"
                                                    ToolTip="{Binding ubicacion}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding codigo_barras}"
                                                               FontFamily="Consolas, Courier New"
                                                               FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding ubicacion}" FontSize="9.5"
                                                               Foreground="{StaticResource BrushTextoSuave}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="lblSinEjemplares" Style="{StaticResource Subtitulo}"
                                           Text="Selecciona un título de la lista para ver sus copias."/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ····· PASO 3: confirmar ····· -->
                    <Grid x:Name="panelPaso3" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button x:Name="btnVolverPaso2" DockPanel.Dock="Right" Content="⟵  Agregar más libros"
                                    Style="{StaticResource BotonPlano}" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="Revisa antes de entregar" Style="{StaticResource TituloTarjeta}"/>
                                <TextBlock Text="Confirma la fecha de devolución y registra el préstamo"
                                           Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,8,0">

                                <!-- Boleta de resumen -->
                                <Border Background="#F7F5EC" CornerRadius="12" Padding="20,18"
                                        BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="COMPROBANTE DE PRÉSTAMO" FontSize="10.5"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextoSuave}"/>
                                        <TextBlock Text="Biblioteca Alejandría" FontSize="17" FontWeight="Bold"
                                                   FontFamily="Georgia, Cambria, Times New Roman"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"
                                                   Foreground="{StaticResource BrushTexto}"/>

                                        <Line Style="{StaticResource LineaPunteada}" X1="0" X2="600"
                                              Margin="0,14,0,14" Stretch="Fill"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="SOCIO" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="lblResumenSocio" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTexto}"/>
                                                <TextBlock x:Name="lblResumenTipo" Style="{StaticResource Subtitulo}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ATIENDE" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="lblResumenUsuario" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTexto}"/>
                                                <TextBlock x:Name="lblResumenFecha" Style="{StaticResource Subtitulo}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Line Style="{StaticResource LineaPunteada}" X1="0" X2="600"
                                              Margin="0,14,0,10" Stretch="Fill"/>

                                        <ItemsControl x:Name="listaResumen">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding CodigoBarras}"
                                                                   Style="{StaticResource Codigo}" FontSize="12"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Titulo}"
                                                                       Style="{StaticResource TituloLibro}" FontSize="13"/>
                                                            <TextBlock FontSize="10.5"
                                                                       Foreground="{StaticResource BrushTextoSuave}">
                                                                <Run Text="{Binding Autor, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Ubicacion, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Line Style="{StaticResource LineaPunteada}" X1="0" X2="600"
                                              Margin="0,10,0,12" Stretch="Fill"/>

                                        <DockPanel>
                                            <TextBlock x:Name="lblResumenVence" DockPanel.Dock="Right"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushPrimario}"/>
                                            <TextBlock Text="Devolver a más tardar el" FontSize="13"
                                                       Foreground="{StaticResource BrushTexto}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Fecha y observación -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="FECHA DE DEVOLUCIÓN" Style="{StaticResource Etiqueta}"/>
                                        <DatePicker x:Name="dtpVencimiento"/>
                                        <TextBlock x:Name="lblPlazoSugerido" FontSize="10.5" Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextoSuave}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="OBSERVACIÓN (OPCIONAL)" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtObservacion" Style="{StaticResource CajaTextoLarga}"
                                                 MaxLength="200" MinHeight="66"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Autorización excepcional -->
                                <Border x:Name="pnlForzar" Visibility="Collapsed" Margin="0,16,0,0"
                                        Background="{StaticResource BrushAdvSuave}" CornerRadius="10"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock x:Name="lblMotivoBloqueo" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="#92400E" FontWeight="SemiBold"/>
                                        <CheckBox x:Name="chkForzar" Margin="0,9,0,0"
                                                  Content="Autorizar el préstamo de todos modos (queda en la bitácora)"
                                                  Foreground="#92400E"/>
                                        <TextBlock x:Name="lblSoloAdmin" Margin="0,6,0,0" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="#92400E"
                                                   Visibility="Collapsed"
                                                   Text="Solo un administrador puede autorizar un préstamo bloqueado."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════════ CARRITO ═══════════ -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ficha del socio -->
                <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SOCIO" Style="{StaticResource Etiqueta}" Margin="0,0,0,5"/>

                        <TextBlock x:Name="lblSinSocio" Text="Todavía no has elegido socio."
                                   Style="{StaticResource Subtitulo}"/>

                        <StackPanel x:Name="pnlSocio" Visibility="Collapsed">
                            <TextBlock x:Name="lblSocioNombre" Style="{StaticResource TituloTarjeta}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="lblSocioDatos" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblSocioAfuera" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTexto}"/>
                                    <TextBlock Text="afuera" FontSize="10.5"
                                               Foreground="{StaticResource BrushTextoSuave}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="lblSocioCupo" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource BrushPrimario}"/>
                                    <TextBlock Text="de cupo" FontSize="10.5"
                                               Foreground="{StaticResource BrushTextoSuave}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="lblSocioDeuda" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTexto}"/>
                                    <TextBlock Text="debe" FontSize="10.5"
                                               Foreground="{StaticResource BrushTextoSuave}"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="pnlBloqueo" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="{StaticResource BrushPeligroSuave}" CornerRadius="9"
                                    Padding="12,9">
                                <TextBlock x:Name="lblBloqueo" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource BrushPeligro}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Carrito -->
                <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button x:Name="btnVaciar" DockPanel.Dock="Right" Content="Vaciar"
                                    Style="{StaticResource BotonPlano}" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock x:Name="lblTituloCarrito" Text="Libros por prestar"
                                           Style="{StaticResource TituloTarjeta}"/>
                                <TextBlock x:Name="lblContadorCarrito" Style="{StaticResource Subtitulo}"
                                           Margin="0,2,0,0" Text="Sin ejemplares agregados"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="listaCarrito">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F5EC" CornerRadius="10" Padding="12,10"
                                                    Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorde}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Titulo}"
                                                                   Style="{StaticResource TituloLibro}"
                                                                   FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource BrushTextoSuave}">
                                                            <Run Text="{Binding CodigoBarras, Mode=OneWay}"
                                                                 FontFamily="Consolas, Courier New"/><Run Text="  ·  "/><Run Text="{Binding Ubicacion, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" FontSize="13"
                                                            Style="{StaticResource BotonPlano}"
                                                            VerticalAlignment="Center" Padding="8,3"
                                                            Click="QuitarEjemplar_Click" Tag="{Binding}"
                                                            ToolTip="Quitar del préstamo"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel x:Name="pnlCarritoVacio" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center"
                                           Opacity="0.35"/>
                                <TextBlock Text="Agrega los ejemplares que se lleva el socio."
                                           Style="{StaticResource Subtitulo}" Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Acción -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Button x:Name="btnSiguiente" Content="Continuar" Style="{StaticResource BotonPrimario}"
                            Height="46" FontSize="14.5"/>
                    <Button x:Name="btnConfirmar" Content="📖  Registrar préstamo"
                            Style="{StaticResource BotonExito}" Height="46" FontSize="14.5"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
