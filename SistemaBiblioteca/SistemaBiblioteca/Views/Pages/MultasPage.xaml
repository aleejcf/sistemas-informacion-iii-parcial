<UserControl x:Class="MultasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= CAJA ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,6,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblPorCobrar" Text="L 0.00" Style="{StaticResource Cifra}" FontSize="23"
                               Foreground="{StaticResource BrushPeligro}"/>
                    <TextBlock Text="Por cobrar" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="6,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblCobrado" Text="L 0.00" Style="{StaticResource Cifra}" FontSize="23"
                               Foreground="{StaticResource BrushExito}"/>
                    <TextBlock Text="Cobrado" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="6,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblCondonado" Text="L 0.00" Style="{StaticResource Cifra}" FontSize="23"
                               Foreground="{StaticResource BrushTextoSuave}"/>
                    <TextBlock Text="Condonado" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Tarjeta}" Margin="6,0,0,0" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="lblPendientes" Text="0" Style="{StaticResource Cifra}"
                               Foreground="{StaticResource BrushAcento}"/>
                    <TextBlock Text="Multas pendientes" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LISTA ================= -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Multas" Style="{StaticResource TituloTarjeta}"/>

                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="txtBuscar" Style="{StaticResource CajaTexto}"/>
                            <TextBlock Text="Folio del préstamo, socio o código…" FontSize="13.5"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                                       Foreground="{StaticResource BrushTextoSuave}"
                                       Visibility="{Binding Text, ElementName=txtBuscar,
                                                    Converter={StaticResource VacioAVisible}}"/>
                        </Grid>
                        <ComboBox x:Name="cboEstado" Grid.Column="1" Margin="0,0,8,0" Tag="Todos los estados"/>
                        <ComboBox x:Name="cboMotivo" Grid.Column="2" Margin="0,0,8,0" Tag="Todos los motivos"/>
                        <Button x:Name="btnLimpiar" Grid.Column="3" Content="Limpiar"
                                Style="{StaticResource BotonPlano}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="dgMultas">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Préstamo" Width="98">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding codigo}" Style="{StaticResource Codigo}"
                                                       FontSize="12.5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Socio" Binding="{Binding socio}"
                                                    Width="*" MinWidth="150"/>
                                <DataGridTemplateColumn Header="Motivo" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding motivo,
                                                                Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding motivo}"
                                                           Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding motivo,
                                                                       Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Días" Binding="{Binding dias_retraso}" Width="55"/>
                                <DataGridTextColumn Header="Monto" Width="95"
                                                    Binding="{Binding monto, StringFormat='L {0:N2}'}"/>
                                <DataGridTextColumn Header="Generada" Width="95"
                                                    Binding="{Binding fecha_generada, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                <DataGridTemplateColumn Header="Estado" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding estado,
                                                                Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding estado}"
                                                           Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding estado,
                                                                       Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="pnlVacio" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" Background="White" Margin="1,40,1,1">
                            <TextBlock Text="✅" FontSize="34" HorizontalAlignment="Center"/>
                            <TextBlock Text="No hay multas que coincidan con la búsqueda."
                                       Style="{StaticResource Subtitulo}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= DETALLE ================= -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
                <Grid>
                    <StackPanel x:Name="pnlSinSeleccion" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="34" HorizontalAlignment="Center" Opacity="0.35"/>
                        <TextBlock Text="Selecciona una multa para cobrarla o condonarla."
                                   Style="{StaticResource Subtitulo}" Margin="0,10,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="230"/>
                    </StackPanel>

                    <Grid x:Name="pnlDetalle" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <DockPanel>
                                <Border x:Name="pnlEstado" DockPanel.Dock="Right"
                                        Style="{StaticResource Insignia}" VerticalAlignment="Top">
                                    <TextBlock x:Name="lblEstado" Style="{StaticResource TextoInsignia}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="lblFolio" Style="{StaticResource Codigo}" FontSize="17"/>
                                    <TextBlock x:Name="lblSocio" Style="{StaticResource TituloTarjeta}"
                                               FontSize="14" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Background="#F7F5EC" CornerRadius="12" Padding="18,16" Margin="0,16,0,0"
                                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MONTO DE LA MULTA" Style="{StaticResource Etiqueta}"
                                               Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="lblMonto" FontSize="34" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource BrushPeligro}"/>
                                    <Line Style="{StaticResource LineaPunteada}" X1="0" X2="300"
                                          Margin="0,14,0,12" Stretch="Fill"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MOTIVO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="lblMotivo" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTexto}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="RETRASO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="lblDias" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTexto}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="DETALLE" Style="{StaticResource Etiqueta}"/>
                                <TextBlock x:Name="lblObservacion" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTextoSuave}"/>

                                <TextBlock x:Name="lblEtiquetaCondonar" Text="MOTIVO PARA CONDONAR"
                                           Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtMotivoCondonar" Style="{StaticResource CajaTextoLarga}"
                                         MaxLength="150" MinHeight="60"/>
                                <TextBlock x:Name="lblSoloAdmin" Style="{StaticResource Subtitulo}"
                                           Text="Solo un administrador puede condonar una multa."
                                           TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed"
                                           Foreground="{StaticResource BrushAdvertencia}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button x:Name="btnCobrar" Content="💰  Cobrar multa"
                                    Style="{StaticResource BotonExito}" Height="42"/>
                            <Button x:Name="btnCondonar" Content="🤝  Condonar"
                                    Style="{StaticResource BotonContorno}" Height="38" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
