<UserControl x:Class="UsuariosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaBiblioteca"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LISTA ================= -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Cuentas del personal" Style="{StaticResource TituloTarjeta}"/>
                    <TextBlock Text="Quién opera el sistema. No confundir con los socios, que son quienes se llevan los libros."
                               Style="{StaticResource Subtitulo}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,12">
                    <TextBox x:Name="txtBuscar" Style="{StaticResource CajaTexto}"/>
                    <TextBlock Text="Nombre, usuario o correo…" FontSize="13.5"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                               Foreground="{StaticResource BrushTextoSuave}"
                               Visibility="{Binding Text, ElementName=txtBuscar,
                                            Converter={StaticResource VacioAVisible}}"/>
                </Grid>

                <DataGrid x:Name="dgUsuarios" Grid.Row="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding nombre_completo}"
                                            Width="*" MinWidth="160"/>
                        <DataGridTemplateColumn Header="Usuario" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding usuario}" Style="{StaticResource Codigo}"
                                               FontSize="12" FontWeight="Normal"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Correo" Binding="{Binding email}" Width="180"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding rol}" Width="120"/>
                        <DataGridTextColumn Header="Último acceso" Width="120"
                                            Binding="{Binding ultimo_acceso, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Insignia}"
                                            Background="{Binding situacion,
                                                        Converter={StaticResource EstadoAColorFondo}}">
                                        <TextBlock Text="{Binding situacion}"
                                                   Style="{StaticResource TextoInsignia}"
                                                   Foreground="{Binding situacion,
                                                               Converter={StaticResource EstadoAColor}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================= DETALLE / ALTA ================= -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" Grid.RowSpan="2">

                    <!-- ····· Cuenta seleccionada ····· -->
                    <TabItem Header="Cuenta">
                        <Grid Margin="0,10,0,0">
                            <StackPanel x:Name="pnlSinSeleccion" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="🔑" FontSize="32" HorizontalAlignment="Center" Opacity="0.35"/>
                                <TextBlock Text="Selecciona una cuenta de la lista."
                                           Style="{StaticResource Subtitulo}" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="pnlCuenta" Visibility="Collapsed">
                                <TextBlock x:Name="lblNombre" Style="{StaticResource TituloTarjeta}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="lblEmail" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblUsuario" Style="{StaticResource Codigo}" FontSize="13"
                                           Margin="0,8,0,0"/>

                                <Border x:Name="pnlAvisoPregunta" Visibility="Collapsed" Margin="0,14,0,0"
                                        Background="{StaticResource BrushAdvSuave}" CornerRadius="10"
                                        Padding="12,10">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#92400E"
                                               Text="⚠ Esta cuenta no tiene pregunta de seguridad configurada: no podrá recuperar su contraseña sola."/>
                                </Border>

                                <TextBlock Text="ROL" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="cboRol" Tag="Elige el rol"/>
                                <TextBlock x:Name="lblExplicacionRol" FontSize="10.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource BrushTextoSuave}"/>
                                <Button x:Name="btnGuardarRol" Content="Guardar rol"
                                        Style="{StaticResource BotonPrimario}" Height="36" Margin="0,10,0,0"/>

                                <Separator Margin="0,20,0,6" Background="{StaticResource BrushBorde}"/>

                                <Button x:Name="btnRestablecer" Content="🔑  Restablecer contraseña"
                                        Style="{StaticResource BotonContorno}" Height="38" Margin="0,8,0,0"
                                        ToolTip="Genera una clave temporal que la persona deberá cambiar al entrar"/>
                                <Button x:Name="btnActivar" Content="Activar o desactivar cuenta"
                                        Style="{StaticResource BotonGris}" Height="38" Margin="0,8,0,0"/>
                                <Button x:Name="btnEliminar" Content="🗑  Eliminar cuenta"
                                        Style="{StaticResource BotonPeligro}" Height="38" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- ····· Crear cuenta ····· -->
                    <TabItem Header="Crear cuenta">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel x:Name="panelAlta" Margin="0,0,6,0">
                                <TextBlock Text="La cuenta se crea con una contraseña temporal que su dueño tendrá que cambiar la primera vez que entre."
                                           Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>

                                <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtNuevoNombre" Style="{StaticResource CajaTexto}" MaxLength="80"/>

                                <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtNuevoEmail" Style="{StaticResource CajaTexto}" MaxLength="80"/>

                                <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtNuevoUsuario" Style="{StaticResource CajaTexto}" MaxLength="30"/>

                                <TextBlock Text="ROL" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="cboNuevoRol" Tag="Elige el rol"/>

                                <TextBlock x:Name="lblErrorAlta" Foreground="{StaticResource BrushPeligro}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Visibility="Collapsed"/>

                                <Button x:Name="btnCrear" Content="Crear cuenta"
                                        Style="{StaticResource BotonExito}" Height="42" Margin="0,18,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
