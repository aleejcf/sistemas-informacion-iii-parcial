<Window x:Class="SeleccionarSocioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaBiblioteca"
        Title="Elegir socio — Biblioteca Alejandría" Icon="{StaticResource IconoApp}"
        Height="540" Width="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <local:LogoBiblioteca Tamano="32"/>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="lblTitulo" Text="Elegir socio" Style="{StaticResource TituloPagina}"/>
                <TextBlock x:Name="lblSubtitulo" Style="{StaticResource Subtitulo}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <TextBox x:Name="txtBuscar" Style="{StaticResource CajaTexto}" Height="42"/>
            <TextBlock Text="Nombre, código de socio, identidad o correo…" FontSize="14"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource BrushTextoSuave}"
                       Visibility="{Binding Text, ElementName=txtBuscar,
                                    Converter={StaticResource VacioAVisible}}"/>
        </Grid>

        <DataGrid x:Name="dgSocios" Grid.Row="2">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Código" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding idsocio}" Style="{StaticResource Codigo}" FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Socio" Binding="{Binding nombre_completo}" Width="*" MinWidth="150"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding tipo_socio}" Width="110"/>
                <DataGridTextColumn Header="Correo" Binding="{Binding email}" Width="170"/>
                <DataGridTemplateColumn Header="Situación" Width="115">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Insignia}"
                                    Background="{Binding situacion,
                                                Converter={StaticResource EstadoAColorFondo}}">
                                <TextBlock Text="{Binding situacion}" Style="{StaticResource TextoInsignia}"
                                           Foreground="{Binding situacion,
                                                       Converter={StaticResource EstadoAColor}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonGris}"
                    Width="110" Height="40" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="btnElegir" Content="Elegir" Style="{StaticResource BotonPrimario}"
                    Width="130" Height="40" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
