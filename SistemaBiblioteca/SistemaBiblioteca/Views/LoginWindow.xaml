<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaBiblioteca"
        Title="Iniciar sesión — Biblioteca Alejandría" Icon="{StaticResource IconoApp}"
        Height="640" Width="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI">

    <!-- En vez de partir la ventana en dos, el fondo es una pared de estantería
         completa y el formulario flota encima en una sola tarjeta centrada. -->
    <Border CornerRadius="20" ClipToBounds="True" Background="{StaticResource BrushCuero}"
            MouseLeftButtonDown="Ventana_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <!-- La pared: el patrón teselado de Application.xaml -->
            <Rectangle Fill="{StaticResource PatronEstanteria}" Opacity="0.11"/>

            <!-- Luz cálida cayendo desde arriba, como la lámpara de una sala de
                 lectura: aclara la parte alta de la estantería y deja el resto
                 en penumbra -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,-0.05" GradientOrigin="0.5,-0.05"
                                         RadiusX="0.75" RadiusY="0.65">
                        <GradientStop Color="#4DC9A227" Offset="0"/>
                        <GradientStop Color="#1FC9A227" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Penumbra alrededor del centro, para que la tarjeta blanca se
                 despegue del fondo en vez de competir con los lomos -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                         RadiusX="0.62" RadiusY="0.62">
                        <GradientStop Color="#66081A11" Offset="0"/>
                        <GradientStop Color="#33081A11" Offset="0.6"/>
                        <GradientStop Color="#00081A11" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Cerrar (la ventana no tiene marco propio) -->
            <Button x:Name="btnCerrar" Content="✕" Style="{StaticResource BotonIcono}"
                    Foreground="#9DBBAA" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,12,0" ToolTip="Salir del sistema"/>

            <!-- ══════════ TARJETA DEL FORMULARIO ══════════ -->
            <Border x:Name="tarjeta" Style="{StaticResource TarjetaFlotante}"
                    Width="410" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>

                    <!-- Cabecera de marca dentro de la tarjeta -->
                    <Border Background="{StaticResource BrushLateral}" CornerRadius="18,18,0,0"
                            Padding="30,22,30,20">
                        <StackPanel Orientation="Horizontal">
                            <local:LogoBiblioteca x:Name="logo" Tamano="46" VerticalAlignment="Center"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="20" FontWeight="Bold"
                                           FontFamily="Georgia, Cambria, Times New Roman">
                                    <Run Text="ALEJAN" Foreground="White"/><Run Text="DRÍA" Foreground="{StaticResource BrushAcento}"/>
                                </TextBlock>
                                <TextBlock Text="Sistema de gestión bibliotecaria" FontSize="10.5"
                                           Foreground="#9DBBAA" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Formulario -->
                    <StackPanel x:Name="panelFormulario" Margin="30,24,30,28">
                        <TextBlock x:Name="lblSaludo" Text="¡Bienvenido!" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTexto}"/>
                        <TextBlock x:Name="lblFecha" Style="{StaticResource Subtitulo}" Margin="0,3,0,0"/>

                        <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}" Margin="0,18,0,5"/>
                        <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" Height="42"/>

                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                        <local:CajaClaveVisible x:Name="txtClave" Height="42"/>

                        <TextBlock x:Name="lblCaps" Text="⚠ Bloq Mayús está activado" FontSize="11"
                                   Foreground="{StaticResource BrushAdvertencia}" Margin="0,7,0,0"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed"/>

                        <Button x:Name="btnIngresar" Content="Ingresar" Style="{StaticResource BotonPrimario}"
                                Height="44" Margin="0,18,0,0" FontSize="14"/>

                        <!-- Los dos enlaces en una sola línea, separados por un punto -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="12.5">
                            <Hyperlink x:Name="lnkOlvide" Style="{StaticResource EnlaceSutil}">Olvidé mi contraseña</Hyperlink><Run Text="   ·   " Foreground="{StaticResource BrushBorde}"/><Hyperlink x:Name="lnkRegistro" Style="{StaticResource EnlaceEnfasis}">Crear una cuenta</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pie discreto sobre la pared -->
            <TextBlock Text="Sistema de gestión bibliotecaria" FontSize="10.5" Foreground="#5F8570"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- La tarjeta entra subiendo un poco -->
                    <DoubleAnimation Storyboard.TargetName="tarjeta"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45"/>
                    <!-- El logotipo respira, como una lámpara de lectura -->
                    <DoubleAnimation Storyboard.TargetName="logo"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.75" To="1" Duration="0:0:1.8"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
