<Window x:Class="MiCuentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaBiblioteca"
        Title="Mi cuenta — Biblioteca Alejandría" Icon="{StaticResource IconoApp}"
        Height="640" Width="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <local:LogoBiblioteca Tamano="34"/>
                <TextBlock Text="Mi cuenta" Style="{StaticResource TituloPagina}"
                           Margin="11,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="lblNombre" Style="{StaticResource TituloTarjeta}"/>
                    <TextBlock x:Name="lblEmail" Style="{StaticResource Subtitulo}" Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource Insignia}" Background="{StaticResource BrushPrimarioSuave}">
                            <TextBlock x:Name="lblRol" Style="{StaticResource TextoInsignia}"
                                       Foreground="{StaticResource BrushPrimario}"/>
                        </Border>
                        <Border x:Name="pnlSinPregunta" Style="{StaticResource Insignia}" Margin="7,0,0,0"
                                Background="{StaticResource BrushAdvSuave}" Visibility="Collapsed">
                            <TextBlock Text="⚠ SIN PREGUNTA DE SEGURIDAD"
                                       Style="{StaticResource TextoInsignia}" Foreground="#92400E"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel x:Name="panelFormulario" Margin="0,0,8,0">

                <!-- ===== Correo de la cuenta ===== -->
                <!-- Sin esto, perder el acceso al buzón era perder la cuenta: es la
                     dirección a la que llegan los códigos de recuperación y no se
                     podía cambiar desde ninguna pantalla. -->
                <TextBlock Text="CORREO DE LA CUENTA" Style="{StaticResource TituloTarjeta}"
                           FontSize="14" Margin="0,0,0,2"/>
                <TextBlock Text="Es la dirección a la que llegan los códigos para recuperar tu cuenta. Si perdés el acceso a ella, cambiala antes de quedarte fuera."
                           Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>

                <TextBlock Text="CORREO ACTUAL" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtEmailActual" Style="{StaticResource CajaTexto}"
                         IsReadOnly="True" IsTabStop="False"/>

                <TextBlock Text="CORREO NUEVO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtEmailNuevo" Style="{StaticResource CajaTexto}" MaxLength="80"/>

                <TextBlock Text="TU CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtClaveEmail" Height="38"/>

                <TextBlock Text="Se pide tu contraseña porque esto decide a dónde llegan los códigos de recuperación. Avisaremos a tu correo anterior del cambio."
                           FontSize="11" Foreground="{StaticResource BrushTextoSuave}"
                           Margin="0,7,0,0" TextWrapping="Wrap"/>

                <Button x:Name="btnCambiarEmail" Content="Cambiar correo"
                        Style="{StaticResource BotonPrimario}" Height="38" Margin="0,14,0,0"/>

                <Separator Margin="0,22,0,4" Background="{StaticResource BrushBorde}"/>

                <!-- ===== Pregunta de seguridad ===== -->
                <TextBlock Text="PREGUNTA DE SEGURIDAD" Style="{StaticResource TituloTarjeta}"
                           FontSize="14" Margin="0,0,0,2"/>
                <TextBlock x:Name="lblAvisoPregunta" Style="{StaticResource Subtitulo}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="PREGUNTA" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboPregunta" IsEditable="True" Tag="Elige o escribe una pregunta"/>

                <TextBlock Text="RESPUESTA" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" MaxLength="60"/>

                <Button x:Name="btnGuardarPregunta" Content="Guardar pregunta"
                        Style="{StaticResource BotonPrimario}" Height="38" Margin="0,14,0,0"/>

                <Separator Margin="0,22,0,4" Background="{StaticResource BrushBorde}"/>

                <!-- ===== Cambiar contraseña ===== -->
                <TextBlock Text="CAMBIAR CONTRASEÑA" Style="{StaticResource TituloTarjeta}"
                           FontSize="14" Margin="0,14,0,2"/>
                <TextBlock Text="Escribe la contraseña actual para poder cambiarla."
                           Style="{StaticResource Subtitulo}"/>

                <TextBlock Text="CONTRASEÑA ACTUAL" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtActual" Height="38"/>

                <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtNueva" Height="38"/>

                <TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtNueva2" Height="38"/>

                <TextBlock Text="Mínimo 6 caracteres, combinando letras y números."
                           FontSize="11" Foreground="{StaticResource BrushTextoSuave}" Margin="0,7,0,0"/>

                <Button x:Name="btnCambiarClave" Content="Cambiar contraseña"
                        Style="{StaticResource BotonExito}" Height="38" Margin="0,14,0,0"/>

                <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource BotonGris}"
                Width="110" Height="40" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True"/>
    </Grid>
</Window>
