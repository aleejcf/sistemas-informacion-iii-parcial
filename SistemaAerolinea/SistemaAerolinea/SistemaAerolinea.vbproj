<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SistemaAerolinea</RootNamespace>
    <UseWPF>true</UseWPF>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>

    <!-- Icono del ARCHIVO .exe. `Icon="{StaticResource IconoApp}"` en las ventanas
         solo pinta el icono en tiempo de ejecución; sin esto, el Explorador, el
         acceso directo del escritorio y la barra de tareas muestran el icono
         genérico de Windows. Se regenera con Assets\GenerarIcono.ps1. -->
    <ApplicationIcon>Assets\alas.ico</ApplicationIcon>

    <AssemblyTitle>ALAS Honduras</AssemblyTitle>
    <Product>ALAS Honduras</Product>
    <Description>Sistema de reserva de vuelos — III Parcial</Description>
    <Company>Alejandro Calderón</Company>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Credenciales de Google: el archivo real está excluido del repositorio
         (.gitignore) y se copia a la salida si existe. -->
    <None Update="google-oauth.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="google-oauth.example.json" CopyToOutputDirectory="Never" />

    <!-- Servidor y base de datos. Va PreserveNewest a propósito: si en la
         máquina donde se entrega se edita el archivo de la carpeta de salida
         para apuntar a otro SQL Server, una recompilación no lo pisa. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
