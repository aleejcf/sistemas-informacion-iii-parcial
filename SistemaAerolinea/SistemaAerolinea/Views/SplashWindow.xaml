<Window x:Class="SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="400" Width="780"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI"
        RenderTransformOrigin="0.5,0.5">

    <Window.RenderTransform>
        <ScaleTransform x:Name="escalaVentana"/>
    </Window.RenderTransform>

    <!-- La marca va a la izquierda y el cielo a la derecha. No hay barra de
         progreso: el progreso ES el vuelo. El avión recorre la ruta TGU–MAD
         dejando su estela detrás, y el aeropuerto de destino se enciende al
         llegar. En cuanto la base de datos responde, el avión acelera y aterriza. -->
    <Border CornerRadius="24" ClipToBounds="True" Background="{StaticResource BrushCielo}">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="32" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════ FONDO: sol, estrellas y nubes ══════════ -->
            <Canvas Grid.ColumnSpan="2" ClipToBounds="True">

                <!-- El amanecer asomando por debajo del horizonte, a la derecha.
                     Va con degradado radial que muere en transparente: un relleno
                     plano dejaria el canto del circulo marcado sobre el cielo. -->
                <Ellipse Canvas.Left="486" Canvas.Top="214" Width="470" Height="470">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#59F2B01E" Offset="0"/>
                            <GradientStop Color="#26EA7317" Offset="0.45"/>
                            <GradientStop Color="#00EA7317" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Estrellas: titilan con ritmos distintos para que ninguna
                     acompañe a otra y el cielo no parezca una guirnalda -->
                <Ellipse x:Name="estrella1" Canvas.Left="96"  Canvas.Top="42"  Width="2.4" Height="2.4" Fill="White"/>
                <Ellipse x:Name="estrella2" Canvas.Left="188" Canvas.Top="26"  Width="2"   Height="2"   Fill="White"/>
                <Ellipse x:Name="estrella3" Canvas.Left="262" Canvas.Top="66"  Width="2.6" Height="2.6" Fill="White"/>
                <Ellipse x:Name="estrella4" Canvas.Left="404" Canvas.Top="34"  Width="2.2" Height="2.2" Fill="White"/>
                <Ellipse x:Name="estrella5" Canvas.Left="512" Canvas.Top="88"  Width="2"   Height="2"   Fill="White"/>
                <Ellipse x:Name="estrella6" Canvas.Left="146" Canvas.Top="88"  Width="1.8" Height="1.8" Fill="White"/>
                <Ellipse x:Name="estrella7" Canvas.Left="332" Canvas.Top="18"  Width="2"   Height="2"   Fill="White"/>
                <Ellipse x:Name="estrella8" Canvas.Left="626" Canvas.Top="52"  Width="2.4" Height="2.4" Fill="White"/>

                <!-- Nube alta: cruza despacio, es la que queda más lejos.
                     El desenfoque es lo que las hace nube: sin él se les ve el
                     canto de cada elipse y parecen manchas pegadas. -->
                <Canvas x:Name="nubeAlta" Canvas.Left="-200" Canvas.Top="74" Opacity="0.075">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="desplazaAlta"/>
                    </Canvas.RenderTransform>
                    <Canvas.Effect>
                        <BlurEffect Radius="22"/>
                    </Canvas.Effect>
                    <Ellipse Canvas.Left="0"  Canvas.Top="14" Width="72" Height="26" Fill="White"/>
                    <Ellipse Canvas.Left="34" Canvas.Top="0"  Width="58" Height="42" Fill="White"/>
                    <Ellipse Canvas.Left="74" Canvas.Top="12" Width="66" Height="28" Fill="White"/>
                </Canvas>

                <!-- Nube baja: más grande y más rápida, da sensación de profundidad.
                     Va pegada al borde de abajo para no cruzarse con la marca. -->
                <Canvas x:Name="nubeBaja" Canvas.Left="-260" Canvas.Top="330" Opacity="0.06">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="desplazaBaja"/>
                    </Canvas.RenderTransform>
                    <Canvas.Effect>
                        <BlurEffect Radius="26"/>
                    </Canvas.Effect>
                    <Ellipse Canvas.Left="0"   Canvas.Top="20" Width="96"  Height="34" Fill="White"/>
                    <Ellipse Canvas.Left="46"  Canvas.Top="0"  Width="78"  Height="56" Fill="White"/>
                    <Ellipse Canvas.Left="100" Canvas.Top="16" Width="88"  Height="38" Fill="White"/>
                </Canvas>
            </Canvas>

            <!-- ══════════ MARCA ══════════ -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="46,0,0,0">
                <local:LogoAlas x:Name="logo" Tamano="66" HorizontalAlignment="Left"/>

                <TextBlock Margin="0,18,0,0">
                    <Run Text="A L A S" FontSize="38" Foreground="White" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Text="H O N D U R A S" FontSize="12" Foreground="#BFD4E9"
                           FontWeight="SemiBold" Margin="2,2,0,0"/>

                <Rectangle Height="2" Width="46" HorizontalAlignment="Left" Margin="2,18,0,0"
                           Fill="{StaticResource BrushAcento}"/>

                <TextBlock Text="Conectamos Honduras con el mundo."
                           FontSize="12.5" FontStyle="Italic" Foreground="{StaticResource BrushAcento}"
                           Margin="2,16,0,0"/>

                <TextBlock x:Name="lblEstado" Text="Encendiendo motores…"
                           Foreground="#8AA8C8" FontSize="11" FontWeight="SemiBold"
                           Margin="2,26,0,0"/>

                <TextBlock Text="Sistema de Reserva de Vuelos · III Parcial · Alejandro Calderón"
                           Foreground="#54718F" FontSize="9.5" Margin="2,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ══════════ EL VUELO = PROGRESO ══════════ -->
            <Canvas Grid.Column="1" x:Name="cielo" Width="440" Height="300"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- La ruta prevista, todavía sin volar -->
                <Path x:Name="ruta" Stroke="White" StrokeThickness="1.3"
                      StrokeDashArray="4 6" Opacity="0.22"
                      Data="M 26,236 C 140,236 250,180 404,62"/>

                <!-- La estela: se dibuja por código conforme avanza el vuelo -->
                <Path x:Name="estela" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#F2B01E" Offset="0"/>
                            <GradientStop Color="#FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Aeropuerto de origen: siempre encendido, de ahí se sale -->
                <Ellipse Canvas.Left="20" Canvas.Top="230" Width="12" Height="12"
                         Fill="White" Opacity="0.85"/>
                <Ellipse Canvas.Left="23" Canvas.Top="233" Width="6" Height="6"
                         Fill="{StaticResource BrushLateral}"/>
                <TextBlock Canvas.Left="14" Canvas.Top="248" Text="TGU"
                           Foreground="White" Opacity="0.75"
                           FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"/>

                <!-- Aeropuerto de destino: apagado hasta que el avión llega -->
                <Ellipse x:Name="haloDestino" Canvas.Left="384" Canvas.Top="42"
                         Width="52" Height="52" Fill="{StaticResource BrushAcento}" Opacity="0"/>
                <Ellipse x:Name="puntoDestino" Canvas.Left="398" Canvas.Top="56"
                         Width="12" Height="12" Fill="White" Opacity="0.28"/>
                <TextBlock x:Name="lblDestino" Canvas.Left="392" Canvas.Top="26" Text="MAD"
                           Foreground="White" Opacity="0.35"
                           FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"/>

                <!-- El avión. Su posición y su inclinación las calcula el código
                     a partir de la propia curva, así que siempre va encarado
                     hacia donde vuela. -->
                <Path x:Name="avion" Data="{StaticResource GeoAvion}"
                      Fill="{StaticResource BrushAcento}" Stretch="Uniform"
                      Width="26" Height="26" RenderTransformOrigin="0.5,0.5"
                      Opacity="0">
                    <Path.Effect>
                        <DropShadowEffect Color="#F2B01E" BlurRadius="16"
                                          ShadowDepth="0" Opacity="0.75"/>
                    </Path.Effect>
                    <Path.RenderTransform>
                        <RotateTransform x:Name="giroAvion"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Aparece con fundido y un zoom suave -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="escalaVentana"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.94" To="1" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="escalaVentana"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.94" To="1" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="logo"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.15"/>

                    <!-- El avión asoma en cuanto empieza a rodar -->
                    <DoubleAnimation Storyboard.TargetName="avion"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.3"/>

                    <!-- ── Nubes: cruzan sin parar, a distinta velocidad ── -->
                    <DoubleAnimation Storyboard.TargetName="desplazaAlta"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="1180" Duration="0:0:26"
                                     RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="desplazaBaja"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="1240" Duration="0:0:17"
                                     RepeatBehavior="Forever"/>

                    <!-- ── Estrellas titilando ── -->
                    <DoubleAnimation Storyboard.TargetName="estrella1" Storyboard.TargetProperty="Opacity"
                                     From="0.85" To="0.15" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="estrella2" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="0.9"  Duration="0:0:2.3" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="estrella3" Storyboard.TargetProperty="Opacity"
                                     From="0.7"  To="0.2"  Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="estrella4" Storyboard.TargetProperty="Opacity"
                                     From="0.2"  To="0.8"  Duration="0:0:2.9" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="estrella5" Storyboard.TargetProperty="Opacity"
                                     From="0.9"  To="0.3"  Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="estrella6" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0.85" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="estrella7" Storyboard.TargetProperty="Opacity"
                                     From="0.8"  To="0.25" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="estrella8" Storyboard.TargetProperty="Opacity"
                                     From="0.3"  To="0.9"  Duration="0:0:1.9" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
