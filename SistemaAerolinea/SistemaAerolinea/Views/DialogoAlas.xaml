<Window x:Class="DialogoAlas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Border CornerRadius="16" Background="White" MinWidth="420" MaxWidth="520" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="26" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>
            <!-- Encabezado de marca -->
            <Border Background="{StaticResource BrushLateral}" CornerRadius="16,16,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal">
                    <local:LogoAlas Tamano="24"/>
                    <TextBlock x:Name="lblTitulo" Text="ALAS" Foreground="White" FontSize="14"
                               FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Mensaje -->
            <StackPanel Orientation="Horizontal" Margin="24,22,24,4">
                <TextBlock x:Name="lblIcono" Text="ℹ️" FontSize="34" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblMensaje" FontSize="13.5" TextWrapping="Wrap" MaxWidth="380"
                           Margin="18,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTexto}"/>
            </StackPanel>

            <!-- Dato copiable (localizador de reserva, contraseña temporal…) -->
            <Border x:Name="pnlDato" Visibility="Collapsed" Background="#F2F6FB" CornerRadius="10"
                    Margin="24,14,24,0" Padding="14,11" BorderBrush="{StaticResource BrushBorde}"
                    BorderThickness="1">
                <DockPanel>
                    <Button x:Name="btnCopiar" DockPanel.Dock="Right" Content="Copiar"
                            Style="{StaticResource BotonPlano}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblDato" Style="{StaticResource Codigo}" FontSize="19"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,18,24,20">
                <Button x:Name="btnNo" Content="No" Style="{StaticResource BotonGris}"
                        Width="104" Height="38" Margin="0,0,10,0" Visibility="Collapsed" IsCancel="True"/>
                <Button x:Name="btnSi" Content="Aceptar" Style="{StaticResource BotonPrimario}"
                        Width="116" Height="38" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
