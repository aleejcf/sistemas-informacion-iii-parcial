<Window x:Class="RecuperarClaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="Recuperar contraseña — ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="620" Width="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <local:LogoAlas Tamano="34"/>
                <TextBlock Text="Recuperar contraseña" Style="{StaticResource TituloPagina}"
                           Margin="11,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Indicador de paso -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Border x:Name="paso1" Style="{StaticResource PasoAsistente}">
                    <TextBlock x:Name="txtPaso1" Text="1 · Cuenta" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="paso2" Style="{StaticResource PasoAsistente}">
                    <TextBlock x:Name="txtPaso2" Text="2 · Verificación" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="paso3" Style="{StaticResource PasoAsistente}">
                    <TextBlock x:Name="txtPaso3" Text="3 · Nueva clave" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <Grid x:Name="panelFormulario" Margin="0,0,8,0">

                <!-- ===== PASO 1: identificar la cuenta ===== -->
                <StackPanel x:Name="pnlPaso1">
                    <TextBlock Text="Escribe tu nombre de usuario y te diremos de qué formas puedes verificar que la cuenta es tuya."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>

                    <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" MaxLength="30"/>

                    <Button x:Name="btnBuscar" Content="Continuar"
                            Style="{StaticResource BotonPrimario}" Height="40" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- ===== PASO 2: elegir cómo verificar ===== -->
                <!-- Cada vía comprueba algo que solo el dueño puede tener. La del
                     correo únicamente aparece si hay servidor configurado: sin él,
                     el código no llegaría a su dueño y no verificaría nada. -->
                <StackPanel x:Name="pnlMetodos" Visibility="Collapsed">
                    <TextBlock Text="Elige cómo quieres verificar que la cuenta es tuya."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>

                    <Button x:Name="btnViaPregunta" Style="{StaticResource TarjetaBoton}"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Pregunta de seguridad" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTexto}"/>
                            <TextBlock x:Name="lblEstadoPregunta" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnViaRespaldo" Style="{StaticResource TarjetaBoton}"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Código de respaldo" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTexto}"/>
                            <TextBlock x:Name="lblEstadoRespaldo" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnViaCorreo" Style="{StaticResource TarjetaBoton}"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Código por correo" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTexto}"/>
                            <TextBlock x:Name="lblEstadoCorreo" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border x:Name="pnlSinVias" Background="{StaticResource BrushAdvSuave}"
                            CornerRadius="10" Padding="13,11" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Esta cuenta no tiene ninguna forma de recuperarse"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAdvertencia}" TextWrapping="Wrap"/>
                            <TextBlock Text="Pídele a un Administrador que te restablezca la contraseña desde la pantalla de Usuarios. Después configura tu pregunta de seguridad y guarda tus códigos de respaldo desde Mi cuenta."
                                       FontSize="11.5" Foreground="{StaticResource BrushTextoSuave}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== PASO 2C: código de respaldo ===== -->
                <StackPanel x:Name="pnlRespaldo" Visibility="Collapsed">
                    <TextBlock Text="Escribe uno de los códigos de respaldo que guardaste al registrarte. Cada código sirve una sola vez."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>

                    <TextBlock Text="CÓDIGO DE RESPALDO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtRespaldo" Style="{StaticResource CajaTexto}" MaxLength="16"
                             FontSize="17" FontFamily="Consolas" TextAlignment="Center" Height="46"/>
                    <TextBlock Text="Con guiones o sin ellos, da igual: ABCD-EFGH-JKLM"
                               FontSize="11" Foreground="{StaticResource BrushTextoSuave}" Margin="0,7,0,0"/>

                    <Button x:Name="btnVerificarRespaldo" Content="Verificar código"
                            Style="{StaticResource BotonPrimario}" Height="40" Margin="0,18,0,0"/>
                </StackPanel>

                <!-- ===== PASO 2A: pregunta de seguridad ===== -->
                <StackPanel x:Name="pnlPregunta" Visibility="Collapsed">
                    <TextBlock Text="Responde tu pregunta de seguridad para continuar."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>

                    <Border Background="White" CornerRadius="10" Padding="14,12" Margin="0,14,0,0"
                            BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                        <TextBlock x:Name="lblPregunta" FontSize="13.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{StaticResource BrushTexto}"/>
                    </Border>

                    <TextBlock Text="TU RESPUESTA" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" MaxLength="60"/>

                    <Button x:Name="btnVerificarRespuesta" Content="Verificar respuesta"
                            Style="{StaticResource BotonPrimario}" Height="40" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- ===== PASO 2B: código al correo ===== -->
                <!-- El correo NO se escribe: se manda al que tiene registrado la
                     cuenta y aquí solo se enseña tapado. Si se pudiera escribir, se
                     podría pedir el código de una cuenta ajena a un buzón propio. -->
                <StackPanel x:Name="pnlCorreo" Visibility="Collapsed">
                    <TextBlock Text="Te enviamos un código de un solo uso al correo registrado en tu cuenta. Vence en 30 minutos."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>

                    <Border Background="White" CornerRadius="10" Padding="14,12" Margin="0,14,0,0"
                            BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SE ENVIARÁ A" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextoSuave}"/>
                            <TextBlock x:Name="lblCorreoTapado" Style="{StaticResource Codigo}"
                                       FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnEnviarCodigo" Content="Enviarme el código"
                            Style="{StaticResource BotonPrimario}" Height="40" Margin="0,18,0,0"/>

                    <TextBlock Text="CÓDIGO DE 6 DÍGITOS" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtCodigo" Style="{StaticResource CajaTexto}" MaxLength="6"
                             FontSize="20" FontFamily="Consolas" TextAlignment="Center" Height="46"
                             IsEnabled="False"/>

                    <Button x:Name="btnVerificarCodigo" Content="Verificar código"
                            Style="{StaticResource BotonExito}" Height="40" Margin="0,18,0,0"
                            IsEnabled="False"/>
                </StackPanel>

                <!-- ===== PASO 3: nueva contraseña ===== -->
                <StackPanel x:Name="pnlNuevaClave" Visibility="Collapsed">
                    <TextBlock x:Name="lblCuentaVerificada" Style="{StaticResource Subtitulo}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                    <local:CajaClaveVisible x:Name="txtNueva" Height="38"/>

                    <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                    <local:CajaClaveVisible x:Name="txtNueva2" Height="38"/>

                    <TextBlock Text="Mínimo 6 caracteres, combinando letras y números."
                               FontSize="11" Foreground="{StaticResource BrushTextoSuave}" Margin="0,7,0,0"/>

                    <Button x:Name="btnGuardarClave" Content="Guardar contraseña"
                            Style="{StaticResource BotonExito}" Height="40" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            <Button x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource BotonGris}"
                    Width="110" Height="38" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
