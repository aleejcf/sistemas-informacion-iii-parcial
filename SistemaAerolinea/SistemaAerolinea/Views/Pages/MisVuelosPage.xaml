<UserControl x:Class="MisVuelosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaAerolinea"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ PRÓXIMO VIAJE ═══════════ -->
        <Border Grid.Row="0" x:Name="pnlProximo" Background="{StaticResource BrushCielo}"
                CornerRadius="14" Padding="24,20" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TU PRÓXIMO VUELO" FontSize="9.5" FontWeight="Bold"
                               Foreground="{StaticResource BrushAcento}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="lblOrigen" FontSize="30" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="White"/>
                        <TextBlock Text="→" FontSize="18" Margin="14,0" VerticalAlignment="Center"
                                   Foreground="#8AA8C8"/>
                        <TextBlock x:Name="lblDestino" FontSize="30" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="White"/>
                    </StackPanel>
                    <TextBlock x:Name="lblCiudades" FontSize="12" Foreground="#BFD4E9" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="34,0,0,0">
                    <TextBlock x:Name="lblCuandoSale" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="lblFaltan" FontSize="12" Foreground="{StaticResource BrushAcento}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,26,0">
                    <TextBlock Text="ASIENTO" FontSize="9.5" FontWeight="Bold"
                               Foreground="#8AA8C8" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblAsiento" FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="White" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Border x:Name="bdEstadoBoleto" Style="{StaticResource Insignia}" Padding="11,4">
                        <TextBlock x:Name="lblEstadoBoleto" Style="{StaticResource TextoInsignia}"/>
                    </Border>
                    <Button x:Name="btnCheckInRapido" Content="Hacer check-in"
                            Style="{StaticResource BotonAcento}" Height="36" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ MIS RESERVAS ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <Button x:Name="btnActualizar" DockPanel.Dock="Right" Content="⟳ Actualizar"
                                Style="{StaticResource BotonPlano}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Mis reservas" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Margin="0,3,0,0"
                                       Text="Aquí están tus viajes, también aquellos en los que alguien te llevó como acompañante."/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="dgReservas">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Localizador" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding codigo_reserva}" Style="{StaticResource Codigo}"
                                                       FontSize="13.5" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Titular" Binding="{Binding titular}" Width="*"/>
                                <DataGridTextColumn Header="Reservada" Width="120"
                                                    Binding="{Binding fecha, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                <DataGridTextColumn Header="Boletos" Binding="{Binding boletos}" Width="75"/>
                                <DataGridTextColumn Header="Total" Width="110"
                                                    Binding="{Binding costo, StringFormat='L {0:N2}'}"/>
                                <DataGridTemplateColumn Header="Estado" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="lblVacio" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" FontSize="13" TextWrapping="Wrap" MaxWidth="360"
                                   Foreground="{StaticResource BrushTextoSuave}"
                                   Text="Todavía no tienes reservas. Ve a «Reservar un vuelo» para comprar tu primer boleto."/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════════ DETALLE ═══════════ -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <Grid>
                    <TextBlock x:Name="lblSinSeleccion" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextoSuave}"
                               Text="Elige una reserva para ver tus boletos, hacer el check-in y descargar tu pase de abordar."/>

                    <Grid x:Name="pnlDetalle" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="LOCALIZADOR" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="lblPnr" FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                       Foreground="{StaticResource BrushPrimario}"/>

                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblTotal" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="PAGADO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblPagado" FontSize="13.5" FontWeight="Bold"
                                               Foreground="{StaticResource BrushExito}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SALDO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblSaldo" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>

                            <Border x:Name="pnlAvisoPago" Background="{StaticResource BrushAdvSuave}"
                                    CornerRadius="9" Padding="13,11" Margin="0,14,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="#92400E"
                                               Text="Esta reserva tiene un saldo pendiente. Págala aquí mismo y podrás hacer tu check-in de inmediato."/>
                                    <Button x:Name="btnPagar" Content="🔒  Pagar ahora"
                                            Style="{StaticResource BotonExito}" Height="38" Margin="0,11,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="MIS BOLETOS" Style="{StaticResource Etiqueta}"/>
                        </StackPanel>

                        <DataGrid x:Name="dgBoletos" Grid.Row="1" RowHeight="46">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Vuelo" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                                    <Run Text="{Binding iata_origen, Mode=OneWay}"/>
                                                    <Run Text="→"/>
                                                    <Run Text="{Binding iata_destino, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource BrushTextoSuave}"
                                                           Text="{Binding fecha_salida, StringFormat='{}{0:ddd dd MMM · HH:mm}'}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Asiento" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding asiento}" Style="{StaticResource Codigo}"
                                                       FontSize="15" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Estado" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button x:Name="btnCheckIn" Content="🛄  Hacer check-in del boleto elegido"
                                    Style="{StaticResource BotonPrimario}" Height="40"/>
                            <Button x:Name="btnPase" Content="⤓  Descargar mi pase de abordar"
                                    Style="{StaticResource BotonContorno}" Height="40" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="El pase de abordar se genera después del check-in. Para cancelar una reserva, comunícate con la aerolínea."/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
