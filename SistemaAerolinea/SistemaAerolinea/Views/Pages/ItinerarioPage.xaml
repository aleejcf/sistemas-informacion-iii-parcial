<UserControl x:Class="ItinerarioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaAerolinea"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════ TABLERO ════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de día y filtros -->
            <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker x:Name="dpFecha" Grid.Column="0" Width="142"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="btnDiaAnterior" Content="◀ Día anterior"
                                Style="{StaticResource BotonPlano}"/>
                        <Button x:Name="btnHoy" Content="Hoy"
                                Style="{StaticResource BotonPlano}" Margin="2,0"/>
                        <Button x:Name="btnDiaSiguiente" Content="Día siguiente ▶"
                                Style="{StaticResource BotonPlano}"/>
                    </StackPanel>

                    <TextBlock x:Name="lblFechaLarga" Grid.Column="2" Style="{StaticResource Subtitulo}"
                               VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>

                    <ComboBox x:Name="cboEstado" Grid.Column="3" Width="172" Tag="Todos los estados"/>

                    <Button x:Name="btnActualizar" Grid.Column="4" Content="⟳ Actualizar"
                            Style="{StaticResource BotonPrimario}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Conteos del día -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="15,11" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock x:Name="lblTotalVuelos" Text="0" Style="{StaticResource Cifra}" FontSize="23"/>
                        <TextBlock Text="VUELOS DEL DÍA" Style="{StaticResource Etiqueta}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="15,11" Margin="6,0">
                    <StackPanel>
                        <TextBlock x:Name="lblEnHora" Text="0" Style="{StaticResource Cifra}" FontSize="23"
                                   Foreground="{StaticResource BrushExito}"/>
                        <TextBlock Text="EN HORA" Style="{StaticResource Etiqueta}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="15,11" Margin="6,0">
                    <StackPanel>
                        <TextBlock x:Name="lblRetrasados" Text="0" Style="{StaticResource Cifra}" FontSize="23"
                                   Foreground="{StaticResource BrushAdvertencia}"/>
                        <TextBlock Text="RETRASADOS" Style="{StaticResource Etiqueta}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Tarjeta}" Padding="15,11" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="lblCancelados" Text="0" Style="{StaticResource Cifra}" FontSize="23"
                                   Foreground="{StaticResource BrushPeligro}"/>
                        <TextBlock Text="CANCELADOS" Style="{StaticResource Etiqueta}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pantalla de salidas -->
            <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,13">
                        <TextBlock x:Name="lblResumen" DockPanel.Dock="Right" Style="{StaticResource Subtitulo}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Llegadas y salidas" Style="{StaticResource TituloTarjeta}"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="dgTablero" RowHeight="46" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="HORA" Width="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding fecha_salida, StringFormat='{}{0:HH:mm}'}"
                                                       Style="{StaticResource Codigo}" FontSize="15"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="VUELO" Width="108">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding codigo_vuelo}"
                                                       Style="{StaticResource Codigo}" FontSize="12.5"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="AEROLÍNEA" Binding="{Binding nombre_aero}" Width="*"/>

                                <DataGridTemplateColumn Header="DESTINO" Width="168">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ciudad_destino}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding iata_destino}"
                                                           Style="{StaticResource Codigo}" FontSize="10.5"
                                                           Foreground="{StaticResource BrushTextoSuave}"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="LLEGADA" Width="86"
                                                    Binding="{Binding fecha_llegada, StringFormat='{}{0:HH:mm}'}"/>

                                <DataGridTextColumn Header="DURACIÓN" Width="92"
                                                    Binding="{Binding duracion_minutos, Converter={StaticResource MinutosADuracion}}"/>

                                <DataGridTextColumn Header="PUERTA" Width="76" Binding="{Binding puerta}"/>

                                <DataGridTemplateColumn Header="OCUPACIÓN" Width="136">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextoSuave}"><Run Text="{Binding asientos_vendidos, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding capacidad_pasajeros, Mode=OneWay}"/></TextBlock>
                                                <ProgressBar Style="{StaticResource BarraOcupacion}"
                                                             Value="{Binding ocupacion, Mode=OneWay}"
                                                             Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="ESTADO" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="pnlSinVuelos" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoAvion}" Fill="#C7D4E3" Width="40" Height="40"
                                  Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblSinVuelos" Text="No hay vuelos programados para este día."
                                       Style="{StaticResource Subtitulo}" Margin="0,12,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════ FICHA DEL VUELO ════════════ -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="12,0,0,0" Padding="0">
            <Grid>

                <StackPanel x:Name="pnlSinSeleccion" Margin="26"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoAvion}" Fill="#C7D4E3" Width="46" Height="46"
                          Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock Text="Elige un vuelo del tablero" Style="{StaticResource TituloTarjeta}"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="Aquí verás su ficha, podrás cambiarle el estado y consultar la lista de pasajeros."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Grid x:Name="pnlDetalle" Margin="18" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Ficha -->
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <Border x:Name="bdEstadoVuelo" DockPanel.Dock="Right"
                                    Style="{StaticResource Insignia}" HorizontalAlignment="Right">
                                <TextBlock x:Name="lblEstadoVuelo" Style="{StaticResource TextoInsignia}"/>
                            </Border>
                            <TextBlock x:Name="lblCodigoVuelo" Style="{StaticResource Codigo}" FontSize="19"/>
                        </DockPanel>
                        <TextBlock x:Name="lblAerolinea" Style="{StaticResource Subtitulo}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="lblFechaSalida" Style="{StaticResource Subtitulo}" FontSize="11"
                                   Margin="0,2,0,0"/>

                        <Border Background="#F4F8FC" CornerRadius="11" Padding="13,11" Margin="0,13,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblIataOrigen" Style="{StaticResource Codigo}" FontSize="17"/>
                                    <TextBlock x:Name="lblCiudadOrigen" Style="{StaticResource Subtitulo}"
                                               FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblHoraSalida" FontSize="13.5" FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoAvion}" Fill="{StaticResource BrushPrimario}"
                                          Width="16" Height="16" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="90"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock x:Name="lblDuracion" Style="{StaticResource Subtitulo}"
                                               FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="lblIataDestino" Style="{StaticResource Codigo}" FontSize="17"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblCiudadDestino" Style="{StaticResource Subtitulo}"
                                               FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblHoraLlegada" FontSize="13.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AVIÓN" Style="{StaticResource Etiqueta}" Margin="0,10,0,3"/>
                                <TextBlock x:Name="lblAvion" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="PUERTA" Style="{StaticResource Etiqueta}" Margin="0,10,0,3"/>
                                <TextBlock x:Name="lblPuerta" Style="{StaticResource Codigo}" FontSize="12.5"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,14,0,0">
                            <TextBlock x:Name="lblOcupacion" DockPanel.Dock="Right" Style="{StaticResource Subtitulo}"
                                       FontSize="11"/>
                            <TextBlock Text="OCUPACIÓN" Style="{StaticResource Etiqueta}" Margin="0,0,0,0"/>
                        </DockPanel>
                        <ProgressBar x:Name="barOcupacion" Style="{StaticResource BarraOcupacion}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Cambio de estado -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <Border Height="1" Background="{StaticResource BrushBorde}"/>
                        <TextBlock Text="CAMBIAR ESTADO" Style="{StaticResource Etiqueta}" Margin="0,13,0,5"/>
                        <ComboBox x:Name="cboEstadoVuelo" Tag="Elige el estado nuevo"/>
                        <Button x:Name="btnCambiarEstado" Content="Cambiar estado"
                                Style="{StaticResource BotonPrimario}" Height="38" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblSinPermiso" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushPeligro}" Margin="0,7,0,0"
                                   Text="Solo un administrador puede cancelar un vuelo, porque la cancelación anula los boletos ya vendidos."/>
                    </StackPanel>

                    <!-- Manifiesto -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock x:Name="lblConteoPasajeros" DockPanel.Dock="Right"
                                       Style="{StaticResource Subtitulo}" FontSize="11"/>
                            <TextBlock Text="MANIFIESTO DE PASAJEROS" Style="{StaticResource Etiqueta}"
                                       Margin="0,0,0,0"/>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="dgManifiesto" FontSize="11.5" RowHeight="33" MinHeight="120"
                                      IsHitTestVisible="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="PASAJERO" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding pasajero}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding pasajero}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="ASIENTO" Width="58">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding asiento}" Style="{StaticResource Codigo}"
                                                           FontSize="11.5" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="CLASE" Width="66" Binding="{Binding clase}"/>

                                    <DataGridTemplateColumn Header="ESTADO" Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Insignia}" Padding="7,2"
                                                        Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                                    <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                               FontSize="9.5"
                                                               Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="pnlSinPasajeros" Visibility="Collapsed"
                                       Text="Este vuelo todavía no tiene pasajeros."
                                       Style="{StaticResource Subtitulo}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
