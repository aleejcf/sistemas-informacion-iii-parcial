<UserControl x:Class="ReservasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaAerolinea"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LISTA ═══════════ -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="txtBuscar" Style="{StaticResource CajaTexto}"/>
                        <TextBlock Text="Buscar por localizador, titular o documento…" FontSize="13.5"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                                   Foreground="{StaticResource BrushTextoSuave}"
                                   Visibility="{Binding Text, ElementName=txtBuscar,
                                                Converter={StaticResource VacioAVisible}}"/>
                    </Grid>

                    <ComboBox x:Name="cboEstado" Grid.Column="1" Margin="10,0,0,0" Tag="Todos los estados"/>
                    <Button x:Name="btnLimpiar" Grid.Column="2" Content="Limpiar"
                            Style="{StaticResource BotonPlano}" Margin="6,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="dgReservas">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Localizador" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding codigo_reserva}" Style="{StaticResource Codigo}"
                                                   FontSize="13.5" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Titular" Binding="{Binding titular}" Width="*"/>
                            <DataGridTextColumn Header="Documento" Binding="{Binding num_documento}" Width="130"/>
                            <DataGridTextColumn Header="Fecha" Width="130"
                                                Binding="{Binding fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                            <DataGridTextColumn Header="Boletos" Binding="{Binding boletos}" Width="75"/>
                            <DataGridTextColumn Header="Total" Width="110"
                                                Binding="{Binding costo, StringFormat='L {0:N2}'}"/>
                            <DataGridTextColumn Header="Saldo" Width="110"
                                                Binding="{Binding saldo, StringFormat='L {0:N2}'}"/>
                            <DataGridTemplateColumn Header="Estado" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Insignia}"
                                                Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                            <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                       Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="lblVacio" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" FontSize="13"
                               Foreground="{StaticResource BrushTextoSuave}"
                               Text="No hay reservas que coincidan con la búsqueda."/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ DETALLE ═══════════ -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <Grid>
                <!-- Mensaje guía mientras no hay nada seleccionado -->
                <TextBlock x:Name="lblSinSeleccion" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextoSuave}"
                           Text="Selecciona una reserva de la lista para ver sus boletos, hacer el check-in o cancelarla."/>

                <Grid x:Name="pnlDetalle" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- Cabecera con el localizador -->
                        <Border Background="{StaticResource BrushCielo}" CornerRadius="13" Padding="18,15">
                            <StackPanel>
                                <TextBlock Text="LOCALIZADOR" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{StaticResource BrushAcento}"/>
                                <TextBlock x:Name="lblPnr" FontSize="30" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="White" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblTitular" FontSize="13" Foreground="White" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="lblContacto" FontSize="11" Foreground="#BFD4E9" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Importes -->
                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="lblTotal" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="PAGADO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="lblPagado" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushExito}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="SALDO" Style="{StaticResource Etiqueta}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="lblSaldo" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </UniformGrid>

                        <Border x:Name="pnlObservacion" Background="{StaticResource BrushAdvSuave}"
                                CornerRadius="9" Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="lblObservacion" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="#92400E"/>
                        </Border>

                        <TextBlock Text="BOLETOS" Style="{StaticResource Etiqueta}"/>
                    </StackPanel>

                    <DataGrid x:Name="dgBoletos" Grid.Row="1" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Pasajero" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding pasajero}" FontSize="12.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource BrushTextoSuave}">
                                                <Run Text="{Binding codigo_vuelo, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding clase, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Asiento" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding asiento}" Style="{StaticResource Codigo}"
                                                   FontSize="15" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Estado" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Insignia}"
                                                Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                            <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                       Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="btnCheckIn" Content="🛄  Check-in del boleto seleccionado"
                                Style="{StaticResource BotonPrimario}" Height="40"/>
                        <Button x:Name="btnPases" Content="⤓  Descargar pase de abordar"
                                Style="{StaticResource BotonContorno}" Height="40" Margin="0,8,0,0"/>
                        <Button x:Name="btnCancelar" Content="✕  Cancelar la reserva"
                                Style="{StaticResource BotonPeligro}" Height="40" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblSinPermiso" Visibility="Collapsed" FontSize="11" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource BrushTextoSuave}"
                                   Text="Solo un Administrador puede cancelar reservas."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
