<UserControl x:Class="PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaAerolinea"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,6">

            <!-- ═══════════ INDICADORES PRINCIPALES ═══════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="✈" FontSize="22" Foreground="{StaticResource BrushPrimario}"/>
                        <TextBlock x:Name="lblVuelosHoy" Text="—" Style="{StaticResource Cifra}" Margin="0,8,0,0"/>
                        <TextBlock Text="VUELOS DE HOY" Style="{StaticResource Etiqueta}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="lblProximasSalidas" Style="{StaticResource Subtitulo}" FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="👥" FontSize="22"/>
                        <TextBlock x:Name="lblPasajerosHoy" Text="—" Style="{StaticResource Cifra}" Margin="0,8,0,0"/>
                        <TextBlock Text="PASAJEROS DE HOY" Style="{StaticResource Etiqueta}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="lblTotalPasajeros" Style="{StaticResource Subtitulo}" FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="💰" FontSize="22"/>
                        <TextBlock x:Name="lblIngresosHoy" Text="—" Style="{StaticResource Cifra}"
                                   FontSize="24" Margin="0,8,0,0"/>
                        <TextBlock Text="INGRESOS DE HOY" Style="{StaticResource Etiqueta}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="lblIngresosMes" Style="{StaticResource Subtitulo}" FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="📈" FontSize="22"/>
                        <TextBlock x:Name="lblOcupacion" Text="—" Style="{StaticResource Cifra}" Margin="0,8,0,0"/>
                        <TextBlock Text="OCUPACIÓN PROMEDIO" Style="{StaticResource Etiqueta}" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="barOcupacion" Style="{StaticResource BarraOcupacion}"
                                     Value="0" Margin="0,5,0,3"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ INDICADORES SECUNDARIOS ═══════════ -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,12,0,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="lblReservasHoy" Text="—" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTexto}"/>
                        <TextBlock Text="Reservas de hoy" Style="{StaticResource Subtitulo}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource BrushBorde}" Margin="14,2"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock x:Name="lblPendientes" Text="—" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushAdvertencia}"/>
                        <TextBlock Text="Pendientes de pago" Style="{StaticResource Subtitulo}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Background="{StaticResource BrushBorde}" Margin="14,2"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <TextBlock x:Name="lblAlertas" Text="—" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTextoSuave}"/>
                        <TextBlock Text="Vuelos retrasados o cancelados" Style="{StaticResource Subtitulo}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ GRÁFICO DE INGRESOS ═══════════ -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="btnActualizar" DockPanel.Dock="Right" Content="⟳  Actualizar"
                                Style="{StaticResource BotonContorno}" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Ingresos de los últimos 7 días" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Pagos recibidos en el mostrador, día por día"
                                       Style="{StaticResource Subtitulo}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,16,0,0" MinHeight="210">
                        <StackPanel x:Name="pnlGrafico" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="lblSinGrafico" Text="Todavía no hay pagos registrados en la última semana."
                                   Style="{StaticResource Subtitulo}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════ OPERACIÓN: SALIDAS Y RUTAS ═══════════ -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Próximas salidas -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Próximas salidas" Style="{StaticResource TituloTarjeta}"/>
                        <TextBlock Text="Los vuelos que despegan primero desde ahora"
                                   Style="{StaticResource Subtitulo}" Margin="0,3,0,12"/>

                        <Grid MinHeight="200">
                            <DataGrid x:Name="dgSalidas" VerticalAlignment="Top" RowHeight="46"
                                      VerticalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Vuelo" Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding codigo_vuelo}"
                                                           Style="{StaticResource Codigo}" FontSize="12.5"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Ruta" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ruta}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTexto}"/>
                                                    <TextBlock Text="{Binding ciudad_destino}" FontSize="11"
                                                               Foreground="{StaticResource BrushTextoSuave}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Sale" Width="66"
                                                        Binding="{Binding fecha_salida, StringFormat='{}{0:HH:mm}'}"/>
                                    <DataGridTextColumn Header="Puerta" Width="70" Binding="{Binding puerta}"/>

                                    <DataGridTemplateColumn Header="Estado" Width="118">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Insignia}"
                                                        Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                                    <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                               Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Ocupación" Width="128">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ocupacion, StringFormat='{}{0:N0}%'}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTexto}"/>
                                                        <TextBlock Text="{Binding asientos_vendidos, StringFormat='{} · {0} asientos'}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource BrushTextoSuave}"/>
                                                    </StackPanel>
                                                    <ProgressBar Style="{StaticResource BarraOcupacion}"
                                                                 Value="{Binding ocupacion, Mode=OneWay}"
                                                                 Margin="0,4,6,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="lblSinSalidas" Text="No hay vuelos por salir en este momento."
                                       Style="{StaticResource Subtitulo}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Rutas más vendidas -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Rutas más vendidas" Style="{StaticResource TituloTarjeta}"/>
                        <TextBlock Text="Por boletos emitidos" Style="{StaticResource Subtitulo}" Margin="0,3,0,12"/>

                        <Grid MinHeight="200">
                            <ItemsControl x:Name="icRutas" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushFondo}" CornerRadius="10"
                                                Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ruta}" Style="{StaticResource Codigo}"
                                                               FontSize="13"/>
                                                    <TextBlock Text="{Binding descripcion}" FontSize="11"
                                                               Foreground="{StaticResource BrushTextoSuave}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding ingresos, StringFormat='L {0:N2}'}"
                                                               FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{StaticResource BrushTexto}"/>
                                                    <TextBlock Text="{Binding boletos, StringFormat='{}{0} boletos'}"
                                                               FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource BrushTextoSuave}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="lblSinRutas" Text="Aún no hay boletos vendidos."
                                       Style="{StaticResource Subtitulo}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ ÚLTIMAS RESERVAS ═══════════ -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Últimas reservas" Style="{StaticResource TituloTarjeta}"/>
                    <TextBlock Text="Lo más reciente que pasó por el mostrador"
                               Style="{StaticResource Subtitulo}" Margin="0,3,0,12"/>

                    <Grid MinHeight="190">
                        <DataGrid x:Name="dgReservas" VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Localizador" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding codigo_reserva}"
                                                       Style="{StaticResource Codigo}" FontSize="13"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Titular" Width="*" Binding="{Binding titular}"/>
                                <DataGridTextColumn Header="Fecha" Width="140"
                                                    Binding="{Binding fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>

                                <DataGridTemplateColumn Header="Boletos" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding boletos}" HorizontalAlignment="Right"
                                                       Margin="0,0,12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Total" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding costo, StringFormat='L {0:N2}'}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Margin="0,0,12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Estado" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Insignia}"
                                                    Background="{Binding estado, Converter={StaticResource EstadoAColorFondo}}">
                                                <TextBlock Text="{Binding estado}" Style="{StaticResource TextoInsignia}"
                                                           Foreground="{Binding estado, Converter={StaticResource EstadoAColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="lblSinReservas" Text="Todavía no se ha registrado ninguna reserva."
                                   Style="{StaticResource Subtitulo}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
