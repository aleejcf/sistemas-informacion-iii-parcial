<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="Iniciar sesión — ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="580" Width="940"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Panel de marca ===== -->
        <Border Grid.Column="0" Background="{StaticResource BrushCielo}" ClipToBounds="True">
            <Grid>
                <!-- Estelas de vuelo -->
                <Canvas Opacity="0.15">
                    <Ellipse Canvas.Left="-70" Canvas.Top="-70" Width="240" Height="240"
                             Fill="{StaticResource BrushAtardecer}" Opacity="0.5"/>
                    <Path Stroke="White" StrokeThickness="1.3" StrokeDashArray="5 5"
                          Data="M -40,470 C 120,400 300,300 470,140"/>
                    <Path Stroke="White" StrokeThickness="1" StrokeDashArray="4 6"
                          Data="M -40,560 C 150,500 320,420 470,330"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="34">
                    <local:LogoAlas x:Name="logo" Tamano="116" HorizontalAlignment="Center"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Run Text="A L A S" FontSize="34" Foreground="White" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Text="H O N D U R A S" FontSize="12.5" Foreground="#BFD4E9"
                               HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock Text="Conectamos Honduras con el mundo."
                               FontSize="12.5" FontStyle="Italic" Foreground="{StaticResource BrushAcento}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center"/>

                    <Border Background="#1A3555" CornerRadius="11" Padding="16,12" Margin="0,30,0,0">
                        <StackPanel>
                            <TextBlock Text="SISTEMA DE RESERVA DE VUELOS" FontSize="9.5"
                                       Foreground="#8AA8C8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblFechaMarca" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Formulario ===== -->
        <StackPanel x:Name="panelFormulario" Grid.Column="1" VerticalAlignment="Center" Margin="76,0">
            <TextBlock x:Name="lblSaludo" Text="¡Bienvenido!" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrushTexto}"/>
            <TextBlock Text="Inicia sesión para entrar al mostrador" FontSize="13"
                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,4,0,12"/>

            <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" Height="42"/>

            <TextBlock Text="CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
            <local:CajaClaveVisible x:Name="txtClave" Height="42"/>

            <TextBlock x:Name="lblCaps" Text="⚠ Bloq Mayús está activado" FontSize="11"
                       Foreground="#B45309" Margin="0,7,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed"/>

            <Button x:Name="btnIngresar" Content="Ingresar" Style="{StaticResource BotonPrimario}"
                    Height="44" Margin="0,18,0,0" FontSize="14"/>

            <!-- Acceso con Google: solo aparece si hay credenciales configuradas -->
            <StackPanel x:Name="pnlGoogle" Visibility="Collapsed">
                <Grid Margin="0,16,0,0">
                    <Border Height="1" Background="{StaticResource BrushBorde}" VerticalAlignment="Center"/>
                    <Border Background="White" Padding="12,0" HorizontalAlignment="Center">
                        <TextBlock Text="o" FontSize="11.5" Foreground="{StaticResource BrushTextoSuave}"/>
                    </Border>
                </Grid>

                <Button x:Name="btnGoogle" Height="44" Margin="0,16,0,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="White" CornerRadius="9"
                                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1.5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <!-- La G de Google, vectorial -->
                                    <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Fill="#4285F4" Data="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
                                        <Path Fill="#34A853" Data="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
                                        <Path Fill="#FBBC05" Data="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
                                        <Path Fill="#EA4335" Data="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
                                    </Canvas>
                                    <TextBlock x:Name="txt" Text="Continuar con Google" FontSize="13.5"
                                               FontWeight="SemiBold" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTexto}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F5F8FC"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#B9CADC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="12.5">
                <Hyperlink x:Name="lnkOlvide" Style="{StaticResource EnlaceSutil}">¿Olvidaste tu contraseña?</Hyperlink>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12.5">
                <Run Text="¿No tienes cuenta?" Foreground="{StaticResource BrushTextoSuave}"/>
                <Hyperlink x:Name="lnkRegistro" Style="{StaticResource EnlaceEnfasis}">Regístrate aquí</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- El logotipo late suavemente, como una luz de navegación -->
                    <DoubleAnimation Storyboard.TargetName="logo"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.7" To="1" Duration="0:0:1.6"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
