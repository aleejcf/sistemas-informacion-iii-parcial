<Window x:Class="NuevoPasajeroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="Nuevo pasajero — ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="620" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <local:LogoAlas Tamano="32"/>
                <TextBlock Text="Nuevo pasajero" Style="{StaticResource TituloPagina}"
                           Margin="11,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Subtitulo}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Registra a la persona sin salir del asistente de reserva."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel x:Name="panelFormulario" Margin="0,0,8,0">
                <TextBlock Text="CÓDIGO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtCodigo" Style="{StaticResource CajaTexto}" MaxLength="8"
                         CharacterCasing="Upper"/>

                <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtNombre" Style="{StaticResource CajaTexto}" MaxLength="30"/>

                <TextBlock Text="APELLIDO PATERNO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtApaterno" Style="{StaticResource CajaTexto}" MaxLength="30"/>

                <TextBlock Text="APELLIDO MATERNO (OPCIONAL)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtAmaterno" Style="{StaticResource CajaTexto}" MaxLength="30"/>

                <TextBlock Text="TIPO DE DOCUMENTO" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboTipoDocumento" Tag="Elige el tipo"/>

                <TextBlock Text="NÚMERO DE DOCUMENTO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtDocumento" Style="{StaticResource CajaTexto}" MaxLength="20"/>

                <TextBlock Text="FECHA DE NACIMIENTO" Style="{StaticResource Etiqueta}"/>
                <DatePicker x:Name="dpNacimiento"/>

                <TextBlock Text="PAÍS" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboPais" Tag="Elige el país"
                          DisplayMemberPath="etiqueta" SelectedValuePath="idpais"/>

                <TextBlock Text="TELÉFONO (OPCIONAL)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtTelefono" Style="{StaticResource CajaTexto}" MaxLength="15"/>

                <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtCorreo" Style="{StaticResource CajaTexto}" MaxLength="50"/>

                <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonGris}"
                    Width="110" Height="40" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="btnGuardar" Content="💾 Guardar" Style="{StaticResource BotonExito}"
                    Width="140" Height="40" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
