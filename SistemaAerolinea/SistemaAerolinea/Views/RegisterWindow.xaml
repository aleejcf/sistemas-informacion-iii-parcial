<Window x:Class="RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="Crear cuenta — ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="660" Width="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <local:LogoAlas Tamano="34"/>
                <TextBlock Text="Crear cuenta" Style="{StaticResource TituloPagina}"
                           Margin="11,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="lblAvisoRol" Style="{StaticResource Subtitulo}" Margin="0,7,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel x:Name="panelFormulario" Margin="0,0,8,0">
                <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtNombre" Style="{StaticResource CajaTexto}" MaxLength="80"/>

                <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtEmail" Style="{StaticResource CajaTexto}" MaxLength="80"/>

                <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" MaxLength="30"/>

                <StackPanel x:Name="pnlClaves">
                <TextBlock Text="CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtClave" Height="38"/>

                <!-- Medidor de fuerza: retroalimentación inmediata mientras se escribe -->
                <Grid Margin="0,7,0,0">
                    <ProgressBar x:Name="barraFuerza" Style="{StaticResource BarraOcupacion}"
                                 Height="5" Value="0"/>
                </Grid>
                <TextBlock x:Name="lblFuerza" FontSize="11" Margin="0,5,0,0"
                           Foreground="{StaticResource BrushTextoSuave}"
                           Text="Mínimo 6 caracteres, combinando letras y números."/>

                <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtClave2" Height="38"/>
                </StackPanel>

                <!-- ===== Datos de viajero: solo cuando la cuenta será de pasajero ===== -->
                <StackPanel x:Name="pnlDatosPasajero" Visibility="Collapsed">
                    <Border Background="{StaticResource BrushAdvSuave}" CornerRadius="10"
                            Padding="13,11" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="🧳  TUS DATOS DE VIAJERO" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#92400E"/>
                            <TextBlock Text="Tienen que coincidir con tu documento de identidad: son los que se imprimen en el pase de abordar."
                                       FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Foreground="#92400E"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtNombrePila" Style="{StaticResource CajaTexto}" MaxLength="30"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="APELLIDO PATERNO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtApaterno" Style="{StaticResource CajaTexto}" MaxLength="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="APELLIDO MATERNO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtAmaterno" Style="{StaticResource CajaTexto}" MaxLength="30"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="TIPO DE DOCUMENTO" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="cboTipoDocumento" Tag="Elige el tipo"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="NÚMERO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtDocumento" Style="{StaticResource CajaTexto}" MaxLength="20"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="FECHA DE NACIMIENTO" Style="{StaticResource Etiqueta}"/>
                            <DatePicker x:Name="dpNacimiento"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="TELÉFONO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtTelefono" Style="{StaticResource CajaTexto}" MaxLength="15"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="PAÍS" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cboPais" Tag="Elige tu país"
                              DisplayMemberPath="etiqueta" SelectedValuePath="idpais"/>
                </StackPanel>

                <StackPanel x:Name="pnlSeguridad">
                    <Border Background="{StaticResource BrushPrimarioSuave}" CornerRadius="10"
                            Padding="13,11" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="🔐  RECUPERACIÓN DE LA CUENTA" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource BrushPrimario}"/>
                            <TextBlock Text="Si olvidas tu contraseña, esta pregunta será la forma de recuperarla."
                                       FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Foreground="{StaticResource BrushTextoSuave}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PREGUNTA DE SEGURIDAD" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cboPregunta" IsEditable="True" Tag="Elige o escribe una pregunta"/>

                    <TextBlock Text="RESPUESTA" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" MaxLength="60"/>
                </StackPanel>

                <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonGris}"
                    Width="110" Height="40" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="btnCrear" Content="Crear cuenta" Style="{StaticResource BotonPrimario}"
                    Width="150" Height="40" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
