<Window x:Class="PagarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="Pagar mi reserva — ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="640" Width="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid>

        <!-- ═══════════ CHECKOUT ═══════════ -->
        <Grid x:Name="pnlCheckout" Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <local:LogoAlas Tamano="32"/>
                    <TextBlock Text="Pagar mi reserva" Style="{StaticResource TituloPagina}"
                               Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Resumen de la reserva -->
                <Border Background="{StaticResource BrushCielo}" CornerRadius="13"
                        Padding="18,15" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LOCALIZADOR" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAcento}"/>
                            <TextBlock x:Name="lblPnr" FontSize="26" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="White"/>
                            <TextBlock x:Name="lblItinerario" FontSize="11.5" Foreground="#BFD4E9"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblBoletos" FontSize="11.5" Foreground="#BFD4E9"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="MÉTODO DE PAGO" Style="{StaticResource Etiqueta}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboMetodo" Tag="Elige cómo pagar"
                              DisplayMemberPath="etiqueta" SelectedValuePath="idmetodopago"/>

                    <!-- Por qué no se piden datos de tarjeta -->
                    <Border Background="{StaticResource BrushPrimarioSuave}" CornerRadius="10"
                            Padding="13,11" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="🔒  PAGO SEGURO" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BrushPrimario}"/>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource BrushTextoSuave}"
                                       Text="ALAS nunca te pide ni guarda el número de tu tarjeta: eso lo maneja la pasarela de pago, que solo nos devuelve la autorización. Este proyecto simula esa respuesta."/>
                        </StackPanel>
                    </Border>

                    <!-- Desglose -->
                    <Line Style="{StaticResource LineaPunteada}" X1="0" Y1="0" X2="400" Y2="0" Margin="0,18"/>

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="lblSubtotal" DockPanel.Dock="Right" FontSize="13"/>
                        <TextBlock Text="Subtotal" FontSize="13" Foreground="{StaticResource BrushTextoSuave}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="lblImpuesto" DockPanel.Dock="Right" FontSize="13"/>
                        <TextBlock Text="Impuesto" FontSize="13" Foreground="{StaticResource BrushTextoSuave}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="lblYaPagado" DockPanel.Dock="Right" FontSize="13"
                                   Foreground="{StaticResource BrushExito}"/>
                        <TextBlock Text="Ya pagado" FontSize="13" Foreground="{StaticResource BrushTextoSuave}"/>
                    </DockPanel>

                    <Border Background="White" CornerRadius="11" Padding="15,13" Margin="0,10,0,0"
                            BorderBrush="{StaticResource BrushBorde}" BorderThickness="1.4">
                        <DockPanel>
                            <TextBlock x:Name="lblTotal" DockPanel.Dock="Right" FontSize="27"
                                       FontWeight="Bold" Foreground="{StaticResource BrushExito}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL A PAGAR" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextoSuave}"/>
                                <TextBlock Text="Se cobra el saldo completo" FontSize="10.5"
                                           Foreground="{StaticResource BrushTextoSuave}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <Button x:Name="btnPagar" Content="🔒  Pagar ahora"
                        Style="{StaticResource BotonExito}" Height="48" FontSize="15"/>
                <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonPlano}"
                        Margin="0,8,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ PROCESANDO ═══════════ -->
        <StackPanel x:Name="pnlProcesando" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <local:LogoAlas x:Name="logoProcesando" Tamano="72" HorizontalAlignment="Center"/>
            <TextBlock x:Name="lblProcesando" Text="Conectando con la pasarela de pago…"
                       FontSize="14" Margin="0,22,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource BrushTexto}"/>
            <ProgressBar x:Name="barraProceso" Style="{StaticResource BarraOcupacion}"
                         Width="260" Height="6" Margin="0,14,0,0" Value="0"/>
            <TextBlock Text="No cierres esta ventana" FontSize="11" Margin="0,12,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource BrushTextoSuave}"/>
        </StackPanel>

        <!-- ═══════════ COMPROBANTE ═══════════ -->
        <StackPanel x:Name="pnlListo" Visibility="Collapsed" Margin="34"
                    VerticalAlignment="Center">
            <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource BrushExitoSuave}"
                    HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="40" FontWeight="Bold"
                           Foreground="{StaticResource BrushExito}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="¡Pago aprobado!" FontSize="22" FontWeight="Bold" Margin="0,18,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource BrushTexto}"/>
            <TextBlock x:Name="lblListoDetalle" FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{StaticResource BrushTextoSuave}"/>

            <Border Background="White" CornerRadius="11" Padding="16,14" Margin="0,22,0,0"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1.4">
                <StackPanel>
                    <TextBlock Text="REFERENCIA DE LA OPERACIÓN" FontSize="9.5" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoSuave}"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="btnCopiar" DockPanel.Dock="Right" Content="Copiar"
                                Style="{StaticResource BotonPlano}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblReferencia" Style="{StaticResource Codigo}" FontSize="17"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="lblComprobante" FontSize="11" Margin="0,8,0,0"
                               Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Ya puedes hacer tu check-in y descargar tu pase de abordar."
                       FontSize="12.5" Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextoSuave}"/>

            <Button x:Name="btnListo" Content="Volver a mis vuelos" Style="{StaticResource BotonPrimario}"
                    Height="44" Margin="0,22,0,0"/>
        </StackPanel>
    </Grid>
</Window>
