<Window x:Class="PaseAbordarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="Pases de abordar — ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="740" Width="900" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btnDescargar" Content="⤓  Descargar PDF" Style="{StaticResource BotonPrimario}"
                        Height="40" Width="176"/>
                <Button x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource BotonGris}"
                        Height="40" Width="110" Margin="10,0,0,0" IsCancel="True"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Pases de abordar" Style="{StaticResource TituloPagina}"/>
                <TextBlock x:Name="lblEncabezado" Style="{StaticResource Subtitulo}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
        <!-- Mientras no haya check-in no existe pase que entregar -->
        <TextBlock x:Name="lblSinPases" Visibility="Collapsed" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                   TextAlignment="Center" FontSize="13.5"
                   Foreground="{StaticResource BrushTextoSuave}"/>

        <ScrollViewer x:Name="visorPases" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="pnlPases" Background="Transparent">
                <ItemsControl x:Name="lstPases">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="14" Margin="0,0,0,18"
                                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="228"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ══ Cuerpo del pase ══ -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Franja de marca -->
                                        <Border Background="{StaticResource BrushCielo}" CornerRadius="14,0,0,0"
                                                Padding="20,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="PASE DE ABORDAR"
                                                           Foreground="{StaticResource BrushAcento}"
                                                           FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:LogoAlas Tamano="22"/>
                                                    <TextBlock Text="ALAS HONDURAS" Foreground="White" FontSize="13"
                                                               FontWeight="Bold" Margin="9,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Ruta -->
                                        <Grid Margin="20,18,20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding iata_origen}" FontSize="34"
                                                           FontWeight="Bold" FontFamily="Consolas"
                                                           Foreground="{StaticResource BrushTexto}"/>
                                                <TextBlock Text="{Binding ciudad_origen}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextoSuave}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0">
                                                <Path Data="M0,6 L200,6 M192,2 L200,6 L192,10"
                                                      Stroke="{StaticResource BrushPrimario}" StrokeThickness="1.4"
                                                      Stretch="Uniform" Height="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding iata_destino}" FontSize="34"
                                                           FontWeight="Bold" FontFamily="Consolas"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource BrushTexto}"/>
                                                <TextBlock Text="{Binding ciudad_destino}" FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource BrushTextoSuave}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Pasajero -->
                                        <StackPanel Margin="20,18,20,0">
                                            <TextBlock Text="PASAJERO" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding pasajero}" FontSize="19" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTexto}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding num_documento}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Datos del vuelo -->
                                        <UniformGrid Columns="5" Margin="20,18,20,20">
                                            <StackPanel>
                                                <TextBlock Text="VUELO" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding codigo_vuelo}" Style="{StaticResource Codigo}"
                                                           FontSize="14"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="FECHA" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding fecha_salida, StringFormat='{}{0:dd/MM/yy}'}"
                                                           Style="{StaticResource Codigo}" FontSize="14"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="SALIDA" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding fecha_salida, StringFormat='{}{0:HH:mm}'}"
                                                           Style="{StaticResource Codigo}" FontSize="14"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="PUERTA" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding puerta}" Style="{StaticResource Codigo}"
                                                           FontSize="14"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="EQUIPAJE" Style="{StaticResource Etiqueta}" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding equipaje_incluido_kg, StringFormat='{}{0} kg'}"
                                                           Style="{StaticResource Codigo}" FontSize="14"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- ══ Perforado ══ -->
                                    <Border Grid.Column="1" Width="1.5" Margin="4,14"
                                            BorderBrush="{StaticResource BrushBorde}" BorderThickness="1.5,0,0,0">
                                        <Border.OpacityMask>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,1,8"
                                                          ViewportUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="Black">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,1,4"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <!-- ══ Talón que se queda en la puerta ══ -->
                                    <Border Grid.Column="2" Background="#F5F8FC" CornerRadius="0,14,14,0"
                                            Padding="18,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding nombre_aero}" FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextoSuave}"/>

                                            <TextBlock Text="ASIENTO" Style="{StaticResource Etiqueta}" Margin="0,14,0,2"/>
                                            <TextBlock Text="{Binding asiento}" FontSize="40" FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource BrushPrimario}"/>
                                            <TextBlock Text="{Binding clase}" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTextoSuave}"/>

                                            <TextBlock Text="LOCALIZADOR" Style="{StaticResource Etiqueta}" Margin="0,14,0,2"/>
                                            <TextBlock Text="{Binding codigo_reserva}" FontSize="20" FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource BrushTexto}"/>

                                            <TextBlock Text="{Binding pasajero}" FontSize="11" Margin="0,14,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource BrushTextoSuave}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource BrushTextoSuave}">
                                                <Run Text="{Binding codigo_vuelo, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding fecha_salida, StringFormat='{}{0:dd/MM HH:mm}', Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="El PDF lleva el código de barras PDF417 del estándar IATA BCBP, el mismo que leen los lectores de los aeropuertos. Presenta el pase junto con tu documento de identidad; el embarque cierra 20 minutos antes de la salida."/>
    </Grid>
</Window>
