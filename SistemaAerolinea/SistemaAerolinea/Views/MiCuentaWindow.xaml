<Window x:Class="MiCuentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="Mi cuenta — ALAS Honduras" Icon="{StaticResource IconoApp}"
        Height="640" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ficha del usuario -->
        <Border Grid.Row="0" Style="{StaticResource Tarjeta}">
            <StackPanel Orientation="Horizontal">
                <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource BrushPrimario}">
                    <TextBlock x:Name="lblIniciales" Foreground="White" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="lblNombre" Style="{StaticResource TituloTarjeta}"/>
                    <TextBlock x:Name="lblEmail" Style="{StaticResource Subtitulo}" Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Border x:Name="bdRol" Style="{StaticResource Insignia}"
                                Background="{StaticResource BrushPrimarioSuave}">
                            <TextBlock x:Name="lblRol" Style="{StaticResource TextoInsignia}"
                                       Foreground="{StaticResource BrushPrimario}"/>
                        </Border>
                        <TextBlock x:Name="lblUsuario" Style="{StaticResource Subtitulo}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,16,0,0">

            <!-- ===== Pregunta de seguridad ===== -->
            <TabItem Header="Pregunta de seguridad">
                <Border Style="{StaticResource Tarjeta}" Margin="0,10,0,0">
                    <StackPanel>
                        <Border x:Name="pnlAviso" Background="{StaticResource BrushAdvSuave}" CornerRadius="10"
                                Padding="13,11" Visibility="Collapsed">
                            <TextBlock x:Name="lblAviso" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#92400E"/>
                        </Border>

                        <TextBlock Text="PREGUNTA" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="cboPregunta" IsEditable="True" Tag="Elige o escribe una pregunta"/>

                        <TextBlock Text="RESPUESTA" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" MaxLength="60"/>

                        <TextBlock Text="La respuesta se guarda cifrada y no distingue mayúsculas de minúsculas."
                                   FontSize="11" Foreground="{StaticResource BrushTextoSuave}"
                                   Margin="0,7,0,0" TextWrapping="Wrap"/>

                        <Button x:Name="btnGuardarPregunta" Content="Guardar pregunta"
                                Style="{StaticResource BotonPrimario}" Height="40" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===== Cambiar contraseña ===== -->
            <TabItem Header="Cambiar contraseña">
                <Border Style="{StaticResource Tarjeta}" Margin="0,10,0,0">
                    <StackPanel x:Name="panelClave">
                        <TextBlock Text="CONTRASEÑA ACTUAL" Style="{StaticResource Etiqueta}"/>
                        <local:CajaClaveVisible x:Name="txtActual" Height="38"/>

                        <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                        <local:CajaClaveVisible x:Name="txtNueva" Height="38"/>

                        <TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                        <local:CajaClaveVisible x:Name="txtNueva2" Height="38"/>

                        <TextBlock Text="Mínimo 6 caracteres, combinando letras y números."
                                   FontSize="11" Foreground="{StaticResource BrushTextoSuave}" Margin="0,7,0,0"/>

                        <Button x:Name="btnCambiarClave" Content="Cambiar contraseña"
                                Style="{StaticResource BotonExito}" Height="40" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            <Button x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource BotonGris}"
                    Width="110" Height="38" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
