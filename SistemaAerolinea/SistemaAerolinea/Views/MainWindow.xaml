<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SistemaAerolinea"
        Title="ALAS Honduras — Sistema de Reserva de Vuelos" Icon="{StaticResource IconoApp}"
        Height="810" Width="1380" MinHeight="700" MinWidth="1160"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ MENÚ LATERAL ═══════════ -->
        <Border Grid.Column="0" Background="{StaticResource BrushLateral}">
            <DockPanel>
                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,12">
                    <local:LogoAlas Tamano="40"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="Bold">
                            <Run Text="AL" Foreground="White"/><Run Text="AS" Foreground="{StaticResource BrushAcento}"/>
                        </TextBlock>
                        <TextBlock Text="Honduras · Reserva de vuelos" Foreground="#8AA8C8" FontSize="9.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Usuario conectado -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BrushLateralHover}"
                        CornerRadius="11" Margin="14,4,14,12" Padding="13,11">
                    <StackPanel>
                        <TextBlock x:Name="lblNombreUsuario" Foreground="White" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="{StaticResource BrushAcento}" CornerRadius="6"
                                    Padding="7,2" HorizontalAlignment="Left">
                                <TextBlock x:Name="lblRol" FontSize="9.5" FontWeight="Bold" Foreground="#3B2600"/>
                            </Border>
                            <TextBlock x:Name="lblAvisoSeguridad" Text="⚠" FontSize="13" Margin="7,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource BrushAcento}"
                                       Visibility="Collapsed"
                                       ToolTip="Aún no configuras tu pregunta de seguridad"/>
                        </StackPanel>
                        <Button x:Name="btnMiCuenta" Content="Mi cuenta" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Cursor="Hand" Foreground="#8AA8C8"
                                FontSize="11" Background="Transparent" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               TextDecorations="Underline"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Cerrar sesión -->
                <Button x:Name="btnCerrarSesion" DockPanel.Dock="Bottom" Content="⟵  Cerrar sesión"
                        Style="{StaticResource BotonPeligro}" Margin="14,10,14,16" Height="38"/>

                <!-- Navegación -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,4,4,10">
                        <!-- ===== Portal del pasajero ===== -->
                        <TextBlock x:Name="lblSeccionViaje" Text="MI VIAJE" FontSize="9.5" FontWeight="Bold"
                                   Foreground="#5A7A9C" Margin="24,10,0,6" Visibility="Collapsed"/>
                        <RadioButton x:Name="rbMisVuelos"  Content="🧳   Mis vuelos"          Style="{StaticResource BotonMenu}" GroupName="Nav" Visibility="Collapsed"/>
                        <RadioButton x:Name="rbMiPerfil"   Content="🙋   Mi perfil"           Style="{StaticResource BotonMenu}" GroupName="Nav" Visibility="Collapsed"/>

                        <!-- ===== Personal de la aerolínea ===== -->
                        <TextBlock x:Name="lblSeccionOperacion" Text="OPERACIÓN" FontSize="9.5" FontWeight="Bold"
                                   Foreground="#5A7A9C" Margin="24,10,0,6"/>
                        <RadioButton x:Name="rbPanel"      Content="📊   Panel de control"     Style="{StaticResource BotonMenu}" GroupName="Nav"/>
                        <RadioButton x:Name="rbItinerario" Content="🛫   Llegadas y salidas"   Style="{StaticResource BotonMenu}" GroupName="Nav"/>

                        <TextBlock x:Name="lblSeccionVentas" Text="VENTAS" FontSize="9.5" FontWeight="Bold"
                                   Foreground="#5A7A9C" Margin="24,16,0,6"/>
                        <RadioButton x:Name="rbReservar"   Content="🎫   Nueva reserva"        Style="{StaticResource BotonMenu}" GroupName="Nav"/>
                        <RadioButton x:Name="rbReservas"   Content="📋   Reservas"             Style="{StaticResource BotonMenu}" GroupName="Nav"/>
                        <RadioButton x:Name="rbPagos"      Content="💳   Pagos"                Style="{StaticResource BotonMenu}" GroupName="Nav"/>

                        <TextBlock x:Name="lblSeccionRegistros" Text="REGISTROS" FontSize="9.5" FontWeight="Bold"
                                   Foreground="#5A7A9C" Margin="24,16,0,6"/>
                        <RadioButton x:Name="rbVuelos"     Content="✈   Vuelos"               Style="{StaticResource BotonMenu}" GroupName="Nav"/>
                        <RadioButton x:Name="rbPasajeros"  Content="👤   Pasajeros"            Style="{StaticResource BotonMenu}" GroupName="Nav"/>
                        <RadioButton x:Name="rbCatalogos"  Content="🗂   Catálogos"            Style="{StaticResource BotonMenu}" GroupName="Nav"/>

                        <TextBlock x:Name="lblSeccionAdmin" Text="ADMINISTRACIÓN" FontSize="9.5" FontWeight="Bold"
                                   Foreground="#5A7A9C" Margin="24,16,0,6" Visibility="Collapsed"/>
                        <RadioButton x:Name="rbUsuarios"   Content="🔑   Usuarios"             Style="{StaticResource BotonMenu}" GroupName="Nav" Visibility="Collapsed"/>
                        <RadioButton x:Name="rbBitacora"   Content="📜   Bitácora"             Style="{StaticResource BotonMenu}" GroupName="Nav" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════ CONTENIDO ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Border Grid.Row="0" Background="White" Padding="26,14"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="lblReloj" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTexto}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblFecha" FontSize="11"
                                   Foreground="{StaticResource BrushTextoSuave}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblTituloPagina" Style="{StaticResource TituloPagina}"
                                   Text="Panel de control"/>
                        <TextBlock x:Name="lblSubtituloPagina" Style="{StaticResource Subtitulo}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Página activa -->
            <ContentControl x:Name="Contenido" Grid.Row="1" Margin="22"/>
        </Grid>
    </Grid>
</Window>
