<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SistemaAerolinea.Tests</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OptionStrict>Off</OptionStrict>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Registro ya no tiene una clase local en el proyecto principal (vive solo
         en Comun), asi que las pruebas que la usan sin calificar necesitan este
         Import igual que lo tiene SistemaAerolinea.vbproj. -->
    <Import Include="Comun" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SistemaAerolinea\SistemaAerolinea.vbproj" />
  </ItemGroup>

</Project>
