<Window x:Class="CambiarContrasenaObligatoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParqueaderoWPF"
        Title="Cambio de contraseña obligatorio — PARKO Honduras" Icon="/Assets/logo.ico"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Border Style="{StaticResource Tarjeta}" Margin="24" Padding="28">
        <StackPanel>
            <TextBlock Text="Crea tu nueva contraseña" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BrushTexto}"/>
            <TextBlock Text="Tu cuenta fue creada por un Administrador con una contraseña temporal. Antes de continuar, debes reemplazarla por una que solo tú conozcas."
                       FontSize="12" Foreground="{StaticResource BrushTextoSuave}"
                       TextWrapping="Wrap" Margin="0,4,0,14"/>

            <TextBlock Text="NUEVA CONTRASEÑA (mínimo 6, letras y números)" Style="{StaticResource Etiqueta}"/>
            <local:CajaClaveVisible x:Name="txtNueva" Height="38"/>

            <TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
            <local:CajaClaveVisible x:Name="txtConfirmar" Height="38"/>

            <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <Button x:Name="btnCambiar" Content="Cambiar contraseña y continuar" Style="{StaticResource BotonExito}"
                    Height="40" Margin="0,16,0,0" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
