<Window x:Class="SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PARKO Honduras"
        Height="450" Width="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI"
        RenderTransformOrigin="0.5,0.5">

    <Window.RenderTransform>
        <ScaleTransform x:Name="escalaVentana"/>
    </Window.RenderTransform>

    <Border CornerRadius="22" ClipToBounds="True" Background="#0A2540">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="30" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>

            <!-- Imagen de marca PARKO -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/parko_full.png" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Franja propia para la carga, separada del logo -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <ProgressBar x:Name="barra" Style="{StaticResource BarraCarga}"
                             Width="460" Height="9" Maximum="100" Background="#2E4A6B"/>
                <TextBlock x:Name="lblEstado" Text="Iniciando el sistema…"
                           Foreground="{StaticResource BrushAcento}" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0"/>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Aparece con fundido y un zoom suave -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.7"/>
                    <DoubleAnimation Storyboard.TargetName="escalaVentana"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.92" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="escalaVentana"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.92" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
