<UserControl x:Class="DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tarjetas de estadísticas -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="🚗" FontSize="26"/>
                    <TextBlock x:Name="lblDentro" Text="0" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource BrushPrimario}" Margin="0,4,0,0"/>
                    <TextBlock Text="Vehículos dentro" FontSize="12" Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="💰" FontSize="26"/>
                    <TextBlock x:Name="lblIngresos" Text="L 0.00" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource BrushExito}" Margin="0,4,0,0"/>
                    <TextBlock Text="Ingresos de hoy" FontSize="12" Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="👥" FontSize="26"/>
                    <TextBlock x:Name="lblClientes" Text="0" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource BrushTexto}" Margin="0,4,0,0"/>
                    <TextBlock Text="Clientes registrados" FontSize="12" Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="⏱" FontSize="26"/>
                    <TextBlock x:Name="lblMovsHoy" Text="0" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource BrushTexto}" Margin="0,4,0,0"/>
                    <TextBlock Text="Movimientos de hoy" FontSize="12" Foreground="{StaticResource BrushTextoSuave}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Últimos movimientos -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button x:Name="btnActualizar" DockPanel.Dock="Right" Content="⟳ Actualizar"
                            Style="{StaticResource BotonPrimario}" Padding="12,6"/>
                    <TextBlock Text="Últimos movimientos" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTexto}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="dgUltimos" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Placa" Binding="{Binding placa}" Width="*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding tipo_vehiculo}" Width="*"/>
                        <DataGridTextColumn Header="Entrada" Binding="{Binding fecha_entrada, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="1.5*"/>
                        <DataGridTextColumn Header="Salida" Binding="{Binding fecha_salida, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="1.5*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding total, StringFormat='L {0:N2}'}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

