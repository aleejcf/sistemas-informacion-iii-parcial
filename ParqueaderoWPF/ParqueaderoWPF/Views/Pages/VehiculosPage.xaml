<UserControl x:Class="VehiculosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Lista -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button x:Name="btnLimpiarBusqueda" DockPanel.Dock="Right" Content="✕"
                            Style="{StaticResource BotonGris}" Padding="10,6" Margin="6,0,0,0"/>
                    <Grid>
                        <TextBox x:Name="txtBuscar" Style="{StaticResource CajaTexto}" Height="36"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Buscar por placa, marca o código..." FontSize="15"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource BrushTextoSuave}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <DataGrid x:Name="dgVehiculos" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding codigo_vehiculo}" Width="Auto"/>
                        <DataGridTextColumn Header="Placa" Binding="{Binding placa}" Width="*"/>
                        <DataGridTextColumn Header="Marca" Binding="{Binding marca}" Width="*"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding modelo}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding estado}" Width="*"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding cliente}" Width="1.5*"/>
                        <DataGridTextColumn Header="Ingreso" Binding="{Binding fecha_ingreso, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Formulario -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Datos del vehículo" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTexto}"/>

                    <TextBlock Text="CÓDIGO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtCodigo" Style="{StaticResource CajaTexto}" Height="36" MaxLength="5"/>

                    <TextBlock Text="PLACA" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtPlaca" Style="{StaticResource CajaTexto}" Height="36" MaxLength="10"
                             CharacterCasing="Upper"/>

                    <TextBlock Text="PARQUEADERO" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cboParqueadero" Height="36" FontSize="14"
                              DisplayMemberPath="etiqueta" SelectedValuePath="codigo_parqueadero"/>

                    <TextBlock Text="CLIENTE (DUEÑO)" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cboCliente" Height="36" FontSize="14"
                              DisplayMemberPath="etiqueta" SelectedValuePath="codigo_cliente"/>

                    <TextBlock Text="FECHA DE INGRESO" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="dpFecha" Height="36" FontSize="14"/>

                    <TextBlock Text="MARCA" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtMarca" Style="{StaticResource CajaTexto}" Height="36" MaxLength="20"/>

                    <TextBlock Text="MODELO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtModelo" Style="{StaticResource CajaTexto}" Height="36" MaxLength="20"/>

                    <TextBlock Text="ESTADO" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cboEstado" Height="36" FontSize="14" IsEditable="True"/>

                    <UniformGrid Columns="3" Margin="0,18,0,0">
                        <Button x:Name="btnNuevo" Content="➕ Nuevo" Style="{StaticResource BotonGris}"
                                Margin="0,0,4,0" Height="38"/>
                        <Button x:Name="btnGuardar" Content="💾 Guardar" Style="{StaticResource BotonExito}"
                                Margin="4,0" Height="38"/>
                        <Button x:Name="btnEliminar" Content="🗑 Eliminar" Style="{StaticResource BotonPeligro}"
                                Margin="4,0,0,0" Height="38"/>
                    </UniformGrid>
                    <TextBlock x:Name="lblSoloAdmin" Text="Solo un Administrador puede eliminar registros."
                               FontSize="11" Foreground="{StaticResource BrushTextoSuave}"
                               Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

