<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParqueaderoWPF"
        Title="Iniciar sesión — PARKO Honduras"
        Height="560" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo: marca -->
        <Border Grid.Column="0" Background="{StaticResource BrushLateral}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <Image Source="/Assets/logo.png" Width="130" Height="130" HorizontalAlignment="Center">
                    <Image.Effect>
                        <DropShadowEffect x:Name="brilloLogo" Color="#00E676" BlurRadius="30"
                                          ShadowDepth="0" Opacity="0.5"/>
                    </Image.Effect>
                </Image>
                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Run Text="PAR" FontSize="34" Foreground="White" FontWeight="Bold"/>
                    <Run Text="KO" FontSize="34" Foreground="{StaticResource BrushAcento}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Text="H O N D U R A S" FontSize="14" Foreground="White"
                           HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <TextBlock Text="Espacio inteligente, flujo constante."
                           FontSize="13" FontStyle="Italic" Foreground="#8FB0CE"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Panel derecho: formulario -->
        <StackPanel x:Name="panelFormulario" Grid.Column="1" VerticalAlignment="Center" Margin="80,0">
            <TextBlock x:Name="lblSaludo" Text="¡Bienvenido!" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrushTexto}"/>
            <TextBlock Text="Inicia sesión para continuar" FontSize="13"
                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,4,0,14"/>

            <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" Height="42"/>

            <TextBlock Text="CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
            <local:CajaClaveVisible x:Name="txtClave" Height="42"/>

            <TextBlock x:Name="lblCaps" Text="⚠ Bloq Mayús está activado" FontSize="11"
                       Foreground="#B45309" Margin="0,6,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <Button x:Name="btnIngresar" Content="Ingresar" Style="{StaticResource BotonPrimario}"
                    Height="44" Margin="0,16,0,0" FontSize="14"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="13">
                <Hyperlink x:Name="lnkOlvide" Foreground="{StaticResource BrushTextoSuave}"
                           TextDecorations="None">¿Olvidaste tu contraseña?</Hyperlink>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="13">
                <Run Text="¿No tienes cuenta?" Foreground="{StaticResource BrushTextoSuave}"/>
                <Hyperlink x:Name="lnkRegistro" Foreground="{StaticResource BrushPrimario}"
                           TextDecorations="None" FontWeight="SemiBold">Regístrate aquí</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- El brillo verde del logo late continuamente -->
                    <DoubleAnimation Storyboard.TargetName="brilloLogo"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="0.75" Duration="0:0:1.4"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
