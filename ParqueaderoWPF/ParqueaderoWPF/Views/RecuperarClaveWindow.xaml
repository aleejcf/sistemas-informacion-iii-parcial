<Window x:Class="RecuperarClaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParqueaderoWPF"
        Title="Recuperar contraseña — PARKO Honduras" Icon="/Assets/logo.ico"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Border Style="{StaticResource Tarjeta}" Margin="24" Padding="28">
        <StackPanel>
            <TextBlock Text="Recuperar contraseña" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BrushTexto}"/>
            <TextBlock Text="Responde tu pregunta de seguridad, o recibe un código por correo, para crear una contraseña nueva."
                       FontSize="12" Foreground="{StaticResource BrushTextoSuave}"
                       TextWrapping="Wrap" Margin="0,4,0,10"/>

            <!-- Paso 1: buscar el usuario -->
            <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" Height="38"/>
                <Button x:Name="btnBuscar" Grid.Column="1" Content="Buscar" Style="{StaticResource BotonPrimario}"
                        Height="38" Width="90" Margin="8,0,0,0"/>
            </Grid>

            <!-- Paso 2a: pregunta de seguridad (si la tiene configurada) -->
            <StackPanel x:Name="panelPregunta" Visibility="Collapsed">
                <TextBlock Text="TU PREGUNTA DE SEGURIDAD" Style="{StaticResource Etiqueta}"/>
                <TextBlock x:Name="lblPregunta" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTexto}" TextWrapping="Wrap"/>
                <TextBlock Text="RESPUESTA" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" Height="38"/>
                <Button x:Name="btnVerificar" Content="Verificar respuesta" Style="{StaticResource BotonPrimario}"
                        Height="38" Margin="0,14,0,0"/>
                <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12">
                    <Hyperlink x:Name="lnkPreferirCorreo" Style="{StaticResource EnlaceSutil}">¿Prefieres recibir un código por correo?</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Paso 2b: sin pregunta configurada -> ofrecer código por correo -->
            <StackPanel x:Name="panelSinPregunta" Visibility="Collapsed">
                <TextBlock x:Name="lblSinPregunta" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTexto}"
                           Text="Esta cuenta no tiene pregunta de seguridad configurada. Podemos enviarte un código a tu correo registrado para verificar que eres tú."/>
                <Button x:Name="btnEnviarCodigoCorreo" Content="Enviar código a mi correo"
                        Style="{StaticResource BotonPrimario}" Height="38" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- Paso 2c: verificar el código enviado por correo -->
            <StackPanel x:Name="panelCodigoCorreo" Visibility="Collapsed">
                <TextBlock x:Name="lblCodigoEnviadoA" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextoSuave}" Margin="0,0,0,8"/>
                <TextBlock Text="CÓDIGO RECIBIDO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtCodigoCorreo" Style="{StaticResource CajaTexto}" Height="38" MaxLength="6"/>
                <Button x:Name="btnVerificarCodigoCorreo" Content="Verificar código" Style="{StaticResource BotonPrimario}"
                        Height="38" Margin="0,14,0,0"/>
                <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12">
                    <Hyperlink x:Name="lnkReenviarCodigo" Style="{StaticResource EnlaceSutil}">¿No te llegó? Reenviar código</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Paso 3: nueva contraseña (llega aquí por cualquiera de los dos caminos) -->
            <StackPanel x:Name="panelNueva" Visibility="Collapsed">
                <TextBlock Text="NUEVA CONTRASEÑA (mínimo 6, letras y números)" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtNueva" Height="38"/>
                <TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <local:CajaClaveVisible x:Name="txtConfirmarNueva" Height="38"/>
                <Button x:Name="btnCambiar" Content="Cambiar contraseña" Style="{StaticResource BotonExito}"
                        Height="40" Margin="0,16,0,0"/>
            </StackPanel>

            <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonGris}"
                    Height="34" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>
