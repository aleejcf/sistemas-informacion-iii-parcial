<Window x:Class="RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParqueaderoWPF"
        Title="Crear cuenta — PARKO Honduras"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}" FontFamily="Segoe UI">
    <Border Style="{StaticResource Tarjeta}" Margin="24" Padding="28">
        <StackPanel>
            <TextBlock Text="Crear cuenta" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BrushTexto}"/>
            <TextBlock x:Name="lblInfoRol" FontSize="12" Foreground="{StaticResource BrushTextoSuave}"
                       TextWrapping="Wrap" Margin="0,4,0,10"/>

            <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtNombre" Style="{StaticResource CajaTexto}" Height="38"/>

            <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtEmail" Style="{StaticResource CajaTexto}" Height="38"/>

            <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtUsuario" Style="{StaticResource CajaTexto}" Height="38"/>

            <TextBlock Text="CONTRASEÑA (mínimo 6, letras y números)" Style="{StaticResource Etiqueta}"/>
            <local:CajaClaveVisible x:Name="txtClave" Height="38"/>

            <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
            <local:CajaClaveVisible x:Name="txtConfirmar" Height="38"/>

            <TextBlock Text="PREGUNTA DE SEGURIDAD (para recuperar tu cuenta)" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="cboPregunta" Height="38" FontSize="14" IsEditable="True"/>

            <TextBlock Text="RESPUESTA DE SEGURIDAD" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtRespuesta" Style="{StaticResource CajaTexto}" Height="38"/>

            <TextBlock x:Name="lblError" Foreground="{StaticResource BrushPeligro}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <Button x:Name="btnRegistrar" Content="Registrarme" Style="{StaticResource BotonExito}"
                    Height="42" Margin="0,16,0,0" FontSize="14"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonGris}"
                    Height="36" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
